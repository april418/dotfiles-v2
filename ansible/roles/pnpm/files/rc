# pnpm 10 以下のグローバル設定
# pnpm 11 以降はこのファイルを読まず、同じディレクトリの config.yaml を読む。値を変えたらそちらも揃える
# ~/.npmrc の内容に極力揃えている（項目順も合わせる）
audit=true
audit-level=high
engine-strict=true
ignore-scripts=true
# npm の min-release-age=7（日）に相当。pnpm は分単位のみ（v10.16+）。
minimum-release-age=10080
save-exact=true
# pnpm 10 以下は既定が false。理由は config.yaml の同じ項目にある
verify-deps-before-run=error
