      "Bash(sort:*)",
      "Bash(source:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(unzip:*)",
      "Bash(wc:*)",
      "Bash(which:*)"
    ],
    "ask": [
      "Bash(git fetch *--upl*)",
      "Bash(git ls-remote *--exe*)",
      "Bash(git ls-remote *--u*)",
      "Bash(git pull *--upl*)",
      "Bash(git rebase *--ex*)",
      "Bash(git rebase *-x*)",
      "Bash(git worktree prune:*)",
      "Bash(git worktree remove:*)"
    ],
    "deny": [
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(git clean:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(nc:*)",
      "Bash(npm remove:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm *--engine-strict false*)",
      "Bash(npm *--no-engine-strict*)",
      "Bash(npm *ngine*trict=*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm uninstall:*)",
      "Bash(pnpm add *--pm-on-fail*)",
      "Bash(pnpm install *--pm-on-fail*)",
      "Bash(pnpm update *--pm-on-fail*)",
      "Bash(pnpm *--no-engine-strict*)",
      "Bash(pnpm *ackage*anager*trict=*)",
      "Bash(pnpm *erify*eps*efore*un=*)",
      "Bash(pnpm *inimum*elease*ge*xclude=*)",
      "Bash(pnpm *inimum*elease*ge=*)",
      "Bash(pnpm *ngine*trict=*)",
      "Bash(uv *--exclude-newer*)",
      "Bash(*onfig_engine_strict=*)",
      "Bash(*onfig_minimum_release_age*=*)",
      "Bash(*onfig_package_manager_strict=*)",
      "Bash(*onfig_verify_deps_before_run=*)",
      "Bash(*ONFIG_ENGINE_STRICT=*)",
      "Bash(*ONFIG_MINIMUM_RELEASE_AGE*=*)",
      "Bash(*ONFIG_PACKAGE_MANAGER_STRICT=*)",
      "Bash(*ONFIG_VERIFY_DEPS_BEFORE_RUN=*)",
      "Bash(*UV_EXCLUDE_NEWER=*)",
      "Read(**/.env*)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(**/*-key*)",
      "Read(**/*-token*)",
      "Read(**/*.key*)",
      "Read(**/*.token*)",
      "Read(**/*_key*)",
      "Read(**/*_token*)",
      "Read(**/secrets/**)",
      "Write(**/.env*)",
      "Write(**/secrets/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-branch-base.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reply-language-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/save-session-state.sh",
            "statusMessage": "セッション状態を保存しています"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reload-claude-md.sh",
            "statusMessage": "セッション状態を読み直しています"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/dotfiles notify --format claude"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/prune-evacuated.py",
            "statusMessage": "古い退避物を消しています"
          }
        ]
      }
    ]
  }
}
