def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def write_json(path, data):
    write_text(path, json.dumps(data, ensure_ascii=False))


def write_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def shown(path):
    """コマンド例にそのまま貼れる形にする。"""
    if path.startswith(HOME + os.sep):
        # ~ はクォートの内側に入れると展開されない。
        return "~/" + shlex.quote(path[len(HOME) + 1 :])
    return shlex.quote(path)


def version_key(text):
    """'v0.40.8' や '0.12.14' を大小比較できる形にする。数字を含まなければ None。"""
    numbers = re.findall(r"\d+", text or "")
    return tuple(int(n) for n in numbers) if numbers else None


def find_tool(name):
    found = shutil.which(name)
    if found:
        return found
    for directory in KNOWN_BIN_DIRS:
        path = os.path.join(directory, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def notice(summary, short, commands, steps=None, keys=None):
    """steps は update が実行する (表示, argv) の並び。渡さなければ update の対象にしない。
    keys は断られた内容と比べる値の並びで、省くと summary だけ。summary に件数しか出ないものは、
    取り込み先のバージョンや SHA を渡す。件数だと、上げた後に同じ件数の更新が来たときに断ったものと区別できない。
    """
    return {
        "summary": summary,
        "short": short,
        "commands": commands,
        "steps": steps or [],
        "keys": keys or [summary],
    }


# ---------------------------------------------------------------- dotfiles 本体


def label(repo):
    if repo and os.path.realpath(repo) != os.path.realpath(DEFAULT_REPO):
        return f"dotfiles ({shown(repo)})"
    return "dotfiles"


# 探し方を変えたら zsh の補完（files/_dotfiles）がキャラクター名を探す checkout も合わせる。
def locate():
    """(checkout のルート, 適用記録) を返す。

    適用記録が別の checkout のものなら None にする。見つからなければ (None, None)。
    """
    applied = read_json(APPLIED_FILE)
    if applied and not (isinstance(applied.get("repo"), str) and isinstance(applied.get("commit"), str)):
        applied = None
    candidates = [applied["repo"]] if applied else []
    if os.environ.get("DOTPATH"):
        candidates.append(os.environ["DOTPATH"])
    candidates.append(DEFAULT_REPO)
    for candidate in candidates:
        if not os.path.isdir(candidate):
            continue
        top = git(candidate, "rev-parse", "--show-toplevel")
        if top:
            if applied and os.path.realpath(applied["repo"]) != os.path.realpath(top):
                applied = None
            return top, applied
    return None, None


def count(repo, revs, *paths):
    out = git(repo, "rev-list", "--count", "--no-merges", revs, "--", *paths)
    return int(out) if out is not None else None


def ansible_playbook():
    """プレイブックを流す ansible-playbook。install と同じく ~/.local/bin のものを先に使う。"""
    path = os.path.join(HOME, ".local", "bin", "ansible-playbook")
    return path if os.access(path, os.X_OK) else find_tool("ansible-playbook")


def interpreter_problem(path):
    """スクリプトの先頭行が指すインタープリターが無ければ、その説明を返す。"""
    try:
        with open(path, "rb") as f:
            head = f.read(1024).decode("utf-8", "replace").splitlines()
    except OSError as e:
        return f"cannot read {shown(path)} ({e.strerror})"
    if not head or not head[0].startswith("#!"):
        return None
    interpreter = head[0][2:].strip().split(" ")[0]
    # pip はパスに空白があると sh を経由する起動行を書く（pipx の ~/Library/Application Support など）。
    if os.path.basename(interpreter) == "sh" and len(head) > 1:
        m = re.match(r"'{3}exec' \"([^\"]+)\"", head[1])
        if m:
            interpreter = m.group(1)
    return None if os.path.exists(interpreter) else f"{shown(interpreter)} not found"


def default_remote(repo):
    """origin の既定ブランチの remote-tracking ref（origin/master など）。見つからなければ None。"""
    remote = git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if remote is not None:
        return remote
    return next(
        (r for r in ("origin/main", "origin/master") if git(repo, "rev-parse", "--verify", "--quiet", r)),
        None,
    )


def apply_command(repo):
    """プレイブックを流すコマンドの表示。"""
    return f"ansible-playbook {shown(os.path.join(repo, 'ansible', 'playbook.yml'))} --connection=local"


def check_dotfiles():
    repo, applied = locate()
    result = {"label": label(repo), "where": repo, "notices": [], "warnings": [], "error": None, "remote": None}
    if repo is None:
        result["error"] = "checkout not found (put it at $DOTPATH or ~/.dotfiles)"
        return result

    playbook = os.path.join(repo, "ansible", "playbook.yml")
    apply = apply_command(repo)
    playbook_bin = ansible_playbook()
    apply_steps = [(apply, [playbook_bin or "ansible-playbook", playbook, "--connection=local"])]
    if os.uname().sysname != "Darwin" and os.geteuid() != 0 and find_tool("sudo"):
        # install と同じく先に認証を済ませる。become は macOS 以外の作業にしか無く、
        # 認証が残っていないと ansible は聞かずに "Missing sudo password" で失敗する。
        apply_steps.insert(0, ("sudo -v", ["sudo", "-v"]))
    # venv の Python が消える（Homebrew の cleanup が使われなくなったバージョンを消すなど）と、コマンドはあっても起動しない。
    # 子プロセスを起動せずに分かる範囲で、シェルを開くたびに確かめる。
    problem = "not found" if playbook_bin is None else interpreter_problem(playbook_bin)
    if problem:
        result["warnings"].append(
            f"ansible-playbook does not start ({problem}); rerun {shown(os.path.join(repo, 'install'))}"
        )
        # 流しても失敗するので、update の手順にしない。pull だけを済ませても配置はされない。
        apply_steps = []
    remote = default_remote(repo)
    result["remote"] = remote
    behind = count(repo, f"HEAD..{remote}", DEPLOYED_PATH) if remote else None
    if behind is None:
        result["warnings"].append("origin's default branch is unknown; not compared with the remote")

    if behind:
        branch = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
        summary = f"{behind} commits behind {remote}"
        if branch == remote.split("/", 1)[1]:
            # 配置用の checkout にローカルのコミットがあれば、書き換えずに止める。
            pull = f"git -C {shown(repo)} pull --ff-only origin {branch}"
            commands = [pull, apply]
            steps = (
                [(pull, ["git", "-C", repo, "pull", "--ff-only", "origin", branch])] + apply_steps
                if apply_steps
                else []
            )
        else:
            # 作業ブランチで取り込み方を決めつけると、rebase などを勧めることになるため手順は出さない。
            summary += f" (on {branch or 'detached HEAD'})"
            commands = steps = []
        result["notices"].append(
            notice(summary, summary, commands, steps=steps, keys=[f"dotfiles:pull:{git(repo, 'rev-parse', remote)}"])
        )
        return result

    def apply_notice(summary):
        return notice(
            summary,
            summary,
            [apply],
            steps=apply_steps,
            keys=[f"dotfiles:apply:{git(repo, 'rev-parse', f'HEAD:{DEPLOYED_PATH}')}"],
        )

    if applied is None:
        result["notices"].append(apply_notice("no record of an applied commit"))
        return result

    # 配置先の中身とは比べない。Claude Code が ~/.claude/settings.json を書き換えるため、常にずれて見える。
    commit = applied["commit"]
    if git(repo, "cat-file", "-e", f"{commit}^{{commit}}") is None:
        result["notices"].append(apply_notice("applied commit not in the checkout"))
        return result
    trees = git(repo, "rev-parse", f"{commit}:{DEPLOYED_PATH}", f"HEAD:{DEPLOYED_PATH}")
    if trees is None or len(set(trees.split())) > 1:
        unapplied = count(repo, f"{commit}..HEAD", DEPLOYED_PATH)
        result["notices"].append(
            apply_notice(f"{unapplied} commits not applied" if unapplied else "applied files differ from the checkout")
        )
    return result


def fetch_dotfiles(repo):
    run(["git", "-C", repo, *GIT_FETCH, "origin"], FETCH_TIMEOUT)


# ---------------------------------------------------------------- ツール


class Tool:
    """更新を確かめるツール。

    fetch はネットワークを使ってよく、refresh だけが呼ぶ。返した dict が evaluate と skipped に渡る。
    evaluate と skipped はシェルやセッションを開くたびに呼ばれるので、手元の状態だけで速く判定する。
    更新した直後に古い通知が残らないよう、入っているバージョンなどは毎回読み直す。
    """

    def skipped(self, data):
        """確かめなかった理由。確かめたなら None。"""

    def remark(self, data):
        """dotfiles check にだけ添える補足（待ち期間で見送っているバージョンなど）。無ければ None。"""


def release_cooldown(owner, name, tags, releases=None):
    """ツールの取得の結果。settled は公開から PIN_COOLDOWN を過ぎた最大のバージョン、newest はそれを含む最大のバージョン。"""
    if releases is None:
        releases = github_api(f"/repos/{owner}/{name}/releases?per_page=100")
    settled, _ = settled_tag(owner, name, tags, releases)
    unreleased = {r.get("tag_name") for r in releases if r.get("draft") or r.get("prerelease")}
    candidates = [t for t in tags if t not in unreleased]
    if not candidates:
        return {"settled": settled, "newest": None, "newest_published": None}
    newest = max(candidates, key=version_key)
    published = next((r.get("published_at") for r in releases if r.get("tag_name") == newest), None)
    return {"settled": settled, "newest": newest, "newest_published": published}


def waiting_remark(installed, data):
    """待ち期間のために見送っているバージョンがあれば、その説明。"""
    newest, settled = data.get("newest"), data.get("settled")
    if not isinstance(newest, str) or version_key(installed) is None or version_key(installed) >= version_key(newest):
        return None
    if isinstance(settled, str) and version_key(settled) >= version_key(newest):
        return None
    try:
        days = int((time.time() - parse_time(data["newest_published"])) // (24 * 60 * 60))
    except (TypeError, KeyError, ValueError):
        return f"{newest.lstrip('v')} is in the {PIN_COOLDOWN // (24 * 60 * 60)}-day cooldown"
    return f"{newest.lstrip('v')} released {days}d ago ({PIN_COOLDOWN // (24 * 60 * 60)}-day cooldown)"


class Uv(Tool):
    key = "uv"
    label = "uv"

    def __init__(self, path):
        self.path = path
        # self update できるのは standalone のインストーラーで入れたものだけ。brew や pip で入れたものの
        # 失敗の文言はビルドごとに違うので、インストーラーが残すレシートの導入先で見分ける。
        config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
        prefix = (read_json(os.path.join(config, "uv", "uv-receipt.json")) or {}).get("install_prefix")
        self.standalone = isinstance(prefix, str) and (
            os.path.realpath(prefix) == os.path.realpath(os.path.dirname(path))
        )

    def fetch(self):
        if not self.standalone:
            return {"unsupported": True}
        # uv self update は uv の設定の exclude-newer を見ずに最新を入れるので、公開日時で選んでバージョンを名指しする。
        # 1 件に 40 を超えるアセットが付き、100 件だと 8 MB を超える。待ちを過ぎたバージョンは直近の数十件にある。
        releases = github_api("/repos/astral-sh/uv/releases?per_page=20")
        tags = [
            r["tag_name"]
            for r in releases
            if re.fullmatch(r"\d+\.\d+\.\d+", str(r.get("tag_name"))) and not r.get("draft") and not r.get("prerelease")
        ]
        if not tags:
            raise FetchError("no uv release found")
        data = release_cooldown("astral-sh", "uv", tags, releases)
        settled, installed = data["settled"], self.installed()
        if settled and version_key(installed) and version_key(installed) < version_key(settled):
            try:
                # 勧める前に、そのバージョンへ上げられるかを uv に確かめさせる。
                run([self.path, "self", "update", "--dry-run", settled], FETCH_TIMEOUT)
            except FetchError as e:
                # レシートと実体が食い違うときに出る。毎回の失敗として扱うと通知が出続ける。
                if "Self-update is only available" in str(e):
                    return {"unsupported": True}
                raise
        return data

    def skipped(self, data):
        if data.get("unsupported"):
            return "not installed by the standalone installer"
        return None

    def installed(self):
        # 判定と補足で 2 回呼ぶ。シェルを開くたびに流れるので、起動は 1 回にする。
        if not hasattr(self, "_installed"):
            try:
                m = re.match(r"uv (\S+)", run([self.path, "--version"], 10)[0])
            except FetchError:
                m = None
            self._installed = m.group(1) if m else None
        return self._installed

    def evaluate(self, data):
        settled = data.get("settled")
        if data.get("unsupported") or settled is None:
            return None
        # バージョンはコマンドの引数になるので、リリースのバージョンの形をしていなければ使わない。
        if not isinstance(settled, str) or not re.fullmatch(r"\d+\.\d+\.\d+", settled):
            raise ValueError(f"not a version: {settled!r}")
        installed = self.installed()
        if version_key(installed) is None or version_key(installed) >= version_key(settled):
            return None
        summary = f"uv {installed} → {settled}"
        # uv self update はインストーラを流し直す。UV_NO_MODIFY_PATH が無いとシェルの rc を書き換えうる（uv ロールと同じ）。
        command = f"UV_NO_MODIFY_PATH=1 uv self update {settled}"
        return notice(
            summary,
            summary,
            [command],
            steps=[(command, ["/usr/bin/env", "UV_NO_MODIFY_PATH=1", self.path, "self", "update", settled])],
        )

    def remark(self, data):
        if data.get("unsupported") or not data.get("newest"):
            return None
        return waiting_remark(self.installed(), data)


class Nvm(Tool):
    key = "nvm"
    label = "nvm"

    def __init__(self, directory):
        self.directory = directory
        self.is_git = os.path.isdir(os.path.join(directory, ".git"))

    @staticmethod
    def locate():
        # .zshenv の NVM_DIR と同じ規則。
        directory = os.environ.get("NVM_DIR") or (
            os.path.join(os.environ["XDG_CONFIG_HOME"], "nvm")
            if os.environ.get("XDG_CONFIG_HOME")
            else os.path.join(HOME, ".nvm")
        )
        return directory if os.path.isfile(os.path.join(directory, "nvm.sh")) else None

    def fetch(self):
        args = (
            ["git", "-C", self.directory, "ls-remote", "--tags", "--refs", "origin"]
            if self.is_git
            else ["git", "ls-remote", "--tags", "--refs", NVM_REPO_URL]
        )
        tags = re.findall(r"refs/tags/(v\d+\.\d+\.\d+)$", run(args, FETCH_TIMEOUT)[0], re.MULTILINE)
        if not tags:
            raise FetchError("no release tag found")
        # 固定バージョンの node_nvm_version と同じく、公開から日の浅いバージョンは勧めない。
        return release_cooldown("nvm-sh", "nvm", tags)

    def installed(self):
        return (read_json(os.path.join(self.directory, "package.json")) or {}).get("version")

    def remark(self, data):
        return waiting_remark(self.installed(), data)

    def evaluate(self, data):
        installed = self.installed()
        latest = data.get("settled")
        if latest is None:
            return None
        # update はこの値をコマンドに埋めて実行するので、タグの形をしていなければ使わない。
        # 黙って捨てると最新に見えるので、判定できなかったものとして出す。
        if not isinstance(latest, str) or not re.fullmatch(r"v\d+\.\d+\.\d+", latest):
            raise ValueError(f"latest is not a tag: {latest!r}")
        if version_key(installed) is None or version_key(installed) >= version_key(latest):
            return None
        if self.is_git:
            # install.sh は --depth=1 で clone する。README の fetch --tags だと全タグの履歴まで取りに行くので、
            # install.sh と同じく要るタグだけを取る。
            argvs = [
                ["git", "-C", self.directory, "fetch", "--depth=1", "origin", "tag", latest],
                ["git", "-C", self.directory, "checkout", latest],
            ]
            steps = [(f"git -C {shown(self.directory)} {shlex.join(argv[3:])}", argv) for argv in argvs]
        else:
            # PROFILE=/dev/null が無いと、install.sh が .zshrc に読み込み行を書き足す（.zshenv で読み込み済み）。
            # pipefail と -f が無いと、取得に失敗しても空の入力を bash が読んで 0 で終わる。
            command = (
                f"curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/{latest}/install.sh | PROFILE=/dev/null bash"
            )
            steps = [(command, ["bash", "-o", "pipefail", "-c", command])]
        summary = f"nvm {installed} → {latest.lstrip('v')}"
        return notice(summary, summary, [display for display, _ in steps], steps=steps)


class ClaudeCode(Tool):
    key = "claude"
    label = "Claude Code"

    def __init__(self, path):
        self.path = path

    def installed(self):
        """native インストーラーで入れたものならバージョン、そうでなければ None。"""
        # native のランチャーは ~/.local/share/claude/versions/<バージョン> へのリンクなので、claude --version を起動せずに読める。
        # Homebrew や npm で入れたもの、デスクトップアプリが同梱するものはこの形にならない。
        target = os.path.realpath(self.path)
        versions = os.path.dirname(target)
        if os.path.basename(versions) != "versions" or os.path.basename(os.path.dirname(versions)) != "claude":
            return None
        version = os.path.basename(target)
        return version if re.fullmatch(r"\d+\.\d+\.\d+", version) else None

    @staticmethod
    def channel():
        """claude update が従うチャンネル（settings.json の autoUpdatesChannel。既定は latest）。"""
        config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
        channel = (read_json(os.path.join(config, "settings.json")) or {}).get("autoUpdatesChannel")
        return channel if channel in ("latest", "stable") else "latest"

    def fetch(self):
        if self.installed() is None:
            return {"unsupported": True}
        # Claude Code は起動すれば自分でチャンネルのバージョンへ上がるので、ほかのツールのような待ち期間は置かない。
        channel = self.channel()
        status, body = http_get(f"{CLAUDE_RELEASES}/{channel}")
        if status != 200:
            raise FetchError(f"cannot fetch the {channel} channel version (HTTP {status})")
        version = body.decode("utf-8", "replace").strip()
        if not re.fullmatch(r"\d+\.\d+\.\d+", version):
            raise FetchError(f"cannot parse the {channel} channel version: {version[:40]!r}")
        return {"channel": channel, "version": version}

    def skipped(self, data):
        if self.installed() is None:
            return "not installed by the native installer"
        if data.get("unsupported"):
            return "install method changed; checked on next fetch"
        if data.get("channel") != self.channel():
            return "channel changed; checked on next fetch"
        return None

    def evaluate(self, data):
        installed, latest = self.installed(), data.get("version")
        # 別のチャンネルのバージョンを勧めると、claude update で上げても通知が消えない。
        if installed is None or latest is None or data.get("channel") != self.channel():
            return None
        if not isinstance(latest, str) or not re.fullmatch(r"\d+\.\d+\.\d+", latest):
            raise ValueError(f"not a version: {latest!r}")
        if version_key(installed) >= version_key(latest):
            return None
        summary = f"Claude Code {installed} → {latest}"
        # claude update はシェルの rc を書き換えないので、uv や nvm のような抑える指定は要らない。
        return notice(summary, summary, ["claude update"], steps=[("claude update", [self.path, "update"])])

    def remark(self, data):
        if self.evaluate(data) is None:
            return None
        return "no cooldown (same as auto-update)"


class GitTool(Tool):
    """git で clone して更新するもの（zinit 本体とプラグイン）。"""

    def __init__(self, key, label, path, spec=None):
        """spec はプラグインの user/repo。zinit 本体なら None。"""
        self.key = key
        self.label = label
        self.path = path
        self.spec = spec

    @staticmethod
    def locate():
        found = []
        core = os.path.join(ZINIT_DIR, "zinit.git")
        if os.path.isdir(os.path.join(core, ".git")):
            found.append(GitTool("zinit", "zinit", core))
        plugins = os.path.join(ZINIT_DIR, "plugins")
        for entry in sorted(os.listdir(plugins)) if os.path.isdir(plugins) else []:
            path = os.path.join(plugins, entry)
            # zinit はプラグイン user/repo を user---repo に置く。_local---zinit は git の clone ではない。
            if "---" not in entry or not os.path.isdir(os.path.join(path, ".git")):
                continue
            user, repo = entry.split("---", 1)
            found.append(GitTool(f"zinit:{user}/{repo}", repo, path, f"{user}/{repo}"))
        return found

    def fetch(self):
        run(["git", "-C", self.path, *GIT_FETCH], FETCH_TIMEOUT)
        return {}

    def skipped(self, data):
        # ver ice などで固定していると追跡ブランチが無く、遅れを数えられない。
        if git(self.path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}") is None:
            return "no upstream branch"
        return None

    def settled(self):
        """追跡ブランチのうち、コミットから PIN_COOLDOWN を過ぎた最新のコミット。

        zinit はリリースを作らないのでコミットの日時で測る。日時は書き手が付けるので、偽られたら防げない。
        """
        # 判定と補足で呼ぶので、1 回だけ求める。
        if not hasattr(self, "_settled"):
            # 本流だけを辿る。枝のコミットは、取り込んだマージが待ちを過ぎるまで選ばない。選ぶと早送りできないか、
            # 本流に一度も無かった状態に進めてしまう（本流の親が枝のコミットより古いとき）。
            self._settled = git(
                self.path,
                "rev-list",
                "-1",
                "--first-parent",
                f"--before={int(time.time() - PIN_COOLDOWN)}",
                "@{upstream}",
            )
        return self._settled

    def evaluate(self, data):
        target = self.settled()
        behind = git(self.path, "rev-list", "--count", "--no-merges", f"HEAD..{target}") if target else None
        if not behind or behind == "0":
            return None
        # zinit update や self-update は追跡ブランチの先頭まで進め、出たばかりのコミットも入れる。
        # git で決めたコミットまで進め、zinit が pull の後にするのと同じ compile を流す。
        merge = f"git -C {shown(self.path)} merge --ff-only {target[:12]}"
        steps = [(merge, ["git", "-C", self.path, "merge", "--ff-only", target])]
        if os.path.isfile(os.path.join(self.path, ".gitmodules")):
            # zinit は git pull --recurse-submodules で上げる。merge は submodule の作業ツリーを進めない。
            submodule = f"git -C {shown(self.path)} submodule update --init --recursive"
            steps.append((submodule, ["git", "-C", self.path, "submodule", "update", "--init", "--recursive"]))
        if self.spec:
            compile_display = f"zinit compile {self.spec}"
            zinit_zsh = os.path.join(ZINIT_DIR, "zinit.git", "zinit.zsh")
            # zinit はシェル関数なので、rc を読まない zsh に読み込んで呼ぶ。
            steps.append(
                (compile_display, ["zsh", "-fc", 'source "$1" && zinit compile "$2"', "zsh", zinit_zsh, self.spec])
            )
        else:
            # zinit self-update が pull の後に作り直す wordcode と同じもの（zinit-autoload.zsh の .zinit-self-update）。
            # self-update は先に *.zwc を消すが、zcompile は上書きし、ソースより古い .zwc は zsh が使わないので消さない。
            script = (
                'zcompile -U "$1/zinit.zsh" && zcompile -U "$1"/zinit-{side,install,autoload,additional}.zsh'
                ' && zcompile -U "$1/share/git-process-output.zsh"'
            )
            compile_display = f"zsh -fc {shlex.quote(script)} zsh {shown(self.path)}"
            steps.append((compile_display, ["zsh", "-fc", script, "zsh", self.path]))
        return notice(
            f"{self.label}: {behind} new commits",
            f"{self.label} ({behind} commits)",
            [display for display, _ in steps],
            steps=steps,
            keys=[f"{self.key}@{target}"],
        )

    def remark(self, data):
        target = self.settled()
        young = git(self.path, "rev-list", "--count", "--no-merges", f"{target or 'HEAD'}..@{{upstream}}")
        if (
            not young
            or young == "0"
            or git(self.path, "merge-base", "--is-ancestor", "@{upstream}", "HEAD") is not None
        ):
            return None
        # 枝のコミットは、取り込んだマージコミットが待ち期間を過ぎるまで待つ（追跡ブランチに入ったのはそのとき）。
        return f"{young} commits in the {PIN_COOLDOWN // (24 * 60 * 60)}-day cooldown"


class Brew(Tool):
    key = "brew"
    label = "Homebrew"

    def __init__(self, path):
        self.path = path

    def fetch(self):
        prefix = run([self.path, "--prefix"], FETCH_TIMEOUT)[0].strip()
        try:
            # 自動更新の経過は stderr に出るので、stdout だけを読む。
            outdated = json.loads(run([self.path, "outdated", "--json=v2"], BREW_TIMEOUT)[0])
        except ValueError:
            raise FetchError("cannot parse brew outdated output as JSON")
        packages = []
        for kind, items in (("Cellar", outdated.get("formulae", [])), ("Caskroom", outdated.get("casks", []))):
            for item in items:
                # brew upgrade は pin したものを上げないので、通知しても手順が無い。
                if item.get("pinned"):
                    continue
                # tap の formula は user/tap/name で出るが、Cellar のディレクトリは name だけ。
                name = item["name"].rsplit("/", 1)[-1]
                packages.append(
                    {
                        "name": name,
                        "dir": os.path.join(prefix, kind, name),
                        "installed": item.get("installed_versions") or [],
                        "latest": item.get("current_version"),
                    }
                )
        return {"packages": packages}

    def remark(self, data):
        if not any(self.still_outdated(p) for p in data.get("packages", [])):
            return None
        return "no cooldown (release dates unknown)"

    @staticmethod
    def still_outdated(package):
        # 上げるとバージョンごとのディレクトリが増える。取得時の current_version より新しいバージョンに上がることもあるので、
        # 取得時に入っていたバージョン以外があるかで見る。Caskroom には .metadata もある。
        try:
            versions = [v for v in os.listdir(package["dir"]) if not v.startswith(".")]
        except OSError:
            return False
        return bool(versions) and all(v in package["installed"] for v in versions)

    def evaluate(self, data):
        remaining = [p for p in data.get("packages", []) if self.still_outdated(p)]
        if not remaining:
            return None
        names = [p["name"] for p in remaining]
        listed = ", ".join(names[:5]) + (f" and {len(names) - 5} more" if len(names) > 5 else "")
        return notice(
            f"Homebrew: {len(names)} outdated ({listed})",
            f"Homebrew ({len(names)})",
            ["brew upgrade"],
            steps=[("brew upgrade", [self.path, "upgrade"])],
            # 要約は名前しか出さないので、同じパッケージの次のバージョンが出ても変わらない。
            keys=[f"brew:{p['name']}@{p.get('latest')}" for p in remaining],
        )


def find_tools():
    found = []
    uv = find_tool("uv")
    if uv:
        found.append(Uv(uv))
    nvm = Nvm.locate()
    if nvm:
        found.append(Nvm(nvm))
    claude = find_tool("claude")
    if claude:
        found.append(ClaudeCode(claude))
    found += GitTool.locate()
    brew = find_tool("brew")
    if brew:
        found.append(Brew(brew))
    return found


def evaluate_all(found, entries, remarks=False):
    """取得の結果 entries で found をそれぞれ判定し、(項目, 長く続いている失敗) を返す。

    remarks が真なら補足（Tool.remark）も作る。シェルを開くたびの通知では使わないので、手動の確認でだけ作る。
    """
    items, failures = [], []
    for obj in found:
        if getattr(obj, "problem", None):
            items.append({"key": obj.key, "label": obj.label, "notice": None, "skipped": None, "problem": obj.problem})
            continue
        entry = entries.get(obj.key)
        if not isinstance(entry, dict):
            continue
        data = entry.get("data") if isinstance(entry.get("data"), dict) else None
        item = {"key": obj.key, "label": obj.label, "notice": None, "skipped": None, "problem": None, "remark": None}
        if entry.get("error"):
            item["problem"] = f"fetch failed: {entry['error']}"
        try:
            if data is not None:
                item["notice"] = obj.evaluate(data)
                item["skipped"] = obj.skipped(data)
        except Exception as e:  # noqa: BLE001
            # 1 つの判定の失敗で、ほかの項目や dotfiles 本体の通知まで消さない。
            item["problem"] = f"check failed: {type(e).__name__}: {e}"
        if remarks and data is not None and not item["problem"]:
            try:
                item["remark"] = obj.remark(data)
            except Exception as e:  # noqa: BLE001
                # 補足が作れなくても、判定の結果はそのまま使える。
                item["remark"] = f"remark failed: {type(e).__name__}: {e}"
        items.append(item)
        failure = long_failure(entry)
        if failure:
            failures.append({"label": obj.label, "days": failure[0], "error": failure[1]})
    return items, failures


def check_tools(remarks=False):
    items, failures = evaluate_all(find_tools(), (read_json(TOOLS_FILE) or {}).get("tools") or {}, remarks)
    return {"label": "tools", "items": items, "failures": failures}


# ---------------------------------------------------------------- 固定バージョン
#
# ansible/ 配下の YAML から `# dotfiles: tags` の目印を探し、このマシンに入っているバージョンを最新と比べる。
# 目印があるのにバージョンや入っているバージョンの読み方が無いものは、黙って落とさずに問題として出す。

# 公開から日が浅いバージョンは勧めない。pnpm の minimum-release-age と uv の exclude-newer（どちらも 1 週間）に
# 揃える。リリースの無いタグはコミットの日時で測るので、日時を偽った上流の乗っ取りまでは防げない。
PIN_COOLDOWN = 7 * 24 * 60 * 60
# 一覧に載らなかったタグの公開日時を、リリースとコミットのそれぞれで引く回数の上限。aws-cli は平日に毎日新しい
# バージョンを出すので、PIN_COOLDOWN の中に 8 件並ぶことがある。足りないと最新版を確かめられず、取得の失敗になる。
TAG_LOOKUP_LIMIT = 15
# リリースの一覧を 1 回に取る件数。openai/codex はリリース 1 件に 400 KB ほどのアセットの一覧が付き、100 件だと
# GitHub API が 504 を返す。PIN_COOLDOWN の中に 20 件を超えるリリースを出すので、載らないタグは 1 件ずつ引く。
RELEASES_PER_PAGE = 10

TAG_MARKER = re.compile(r"#\s*dotfiles:\s*tags\s+(\S+)(?:\s+(\S+))?")
KEY_VALUE = re.compile(r"\s*([\w-]+):\s*[\"']?(v?\d+(?:\.\d+)+)[\"']?\s*(?:#.*)?$")
GITHUB_URL = re.compile(r"https://github\.com/([\w.-]+)/([\w.-]+?)(?:\.git)?/?$")


def npm_package_version(directory, package):
    """npm ロールと同じく、DATA_HOME/<directory> に --prefix で入れたパッケージのバージョン。"""
    return (read_json(os.path.join(DATA_HOME, directory, "node_modules", package, "package.json")) or {}).get("version")


def command_version(name, pattern):
    """~/.local/bin/<name> --version の出力から読む。入っていなければ None。"""
    path = os.path.join(HOME, ".local", "bin", name)
    if not os.path.isfile(path):
        return None
    out = run([path, "--version"], 10)[0].strip()
    m = re.match(pattern, out)
    if not m:
        raise ValueError(f"cannot parse the version from {name} --version: {out[:40]!r}")
    return m.group(1)


def awscli_version():
    directory = os.path.join(DATA_HOME, "aws-cli")
    if sys.platform == "darwin":
        # `aws --version` は起動に 0.2〜0.9 秒かかり、シェルを開くたびには流せない。install.sh が導入先に残す記録を読む。
        record = read_json(os.path.join(directory, "awscli", "data", "install.json")) or {}
        version = (record.get("script_install") or {}).get("version_resolved")
        installed = os.path.exists(os.path.join(directory, "aws"))
    else:
        # Linux の zip は v2/<バージョン> に入れ、v2/current をそこへのリンクにする。
        current = os.path.join(directory, "v2", "current")
        version = os.path.basename(os.path.realpath(current)) if os.path.islink(current) else None
        installed = os.path.lexists(current)
    # 入っているのに読めないものを「入っていない」にすると、ロールの `aws --version` の判定と食い違ったまま黙る。
    if version is None and installed:
        raise ValueError(f"cannot read the AWS CLI version in {shown(directory)}")
    return version


def claude_plugin_version(name):
    config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
    plugins = (read_json(os.path.join(config, "plugins", "installed_plugins.json")) or {}).get("plugins")
    entries = plugins.get(name) if isinstance(plugins, dict) else None
    for entry in entries if isinstance(entries, list) else []:
        if isinstance(entry, dict) and entry.get("scope") == "user":
            return entry.get("version")
    return None


# 目印を付けた変数ごとの、入っているバージョンの読み方。ロールが入れる導入先を読む（awscli は記録のファイル、
# yomiyasu は Claude Code の記録）。入っていなければ None を返す。目印を足したら、ここにも足す。
