def settled_tag(owner, name, tags, releases=None):
    """tags のうち、公開から PIN_COOLDOWN を過ぎた最大のバージョンとその公開日時を返す。どれも日が浅ければ (None, None)。

    releases は取得済みの GitHub のリリースの一覧で、載っていないタグはリリースが無いものとして扱う。
    渡さなければ直近の RELEASES_PER_PAGE 件を取りに行き、それが埋まっていれば、載らなかったタグのリリースを 1 件ずつ引く。
    """
    paged = releases is None
    if paged:
        releases = github_api(f"/repos/{owner}/{name}/releases?per_page={RELEASES_PER_PAGE}")
        paged = len(releases) >= RELEASES_PER_PAGE
    releases = {r["tag_name"]: r for r in releases}
    # リリースの無いタグはリリースとコミットの両方を引くので、上限を分けて数える。
    lookups = {"releases": 0, "commits": 0}

    def lookup(path):
        kind = path.split("/")[4]
        if lookups[kind] >= TAG_LOOKUP_LIMIT:
            raise FetchError(
                f"no version past the {PIN_COOLDOWN // (24 * 60 * 60)}-day cooldown"
                f" (hit the limit of {TAG_LOOKUP_LIMIT} release date lookups)"
            )
        lookups[kind] += 1
        status, body = http_get(f"{GITHUB_API}{path}", token=github_token())
        if status == 404:
            return None
        if status != 200:
            raise FetchError(f"GitHub API {path} returned HTTP {status}")
        return json.loads(body)

    for tag in sorted(tags, key=version_key, reverse=True):
        release = releases.get(tag)
        if release is None and paged:
            release = lookup(f"/repos/{owner}/{name}/releases/tags/{tag}")
        if release is not None:
            if release.get("draft") or release.get("prerelease"):
                continue
            published = release.get("published_at")
        else:
            # リリースを作らないリポジトリもある。そのバージョンのコミットの日時で代える。
            commit = lookup(f"/repos/{owner}/{name}/commits/{tag}")
            if commit is None:
                raise FetchError(f"GitHub API has no commit for {tag}")
            published = commit["commit"]["committer"]["date"]
        if published and time.time() - parse_time(published) >= PIN_COOLDOWN:
            return tag, published
    return None, None


class Pin(Tool):
    problem = None

    def __init__(self, key, label, rel, line):
        self.key = key
        self.label = label
        self.rel = rel
        self.line = line
        self.where = f"{rel}:{line}"


class BrokenPin(Pin):
    """固定しようとしているのにバージョンを読めない箇所。"""

    def __init__(self, rel, line, problem):
        super().__init__(f"broken:{rel}:{line}", f"{rel}:{line}", rel, line)
        self.problem = problem

    def fetch(self):
        return {}


class TagPin(Pin):
    """`# dotfiles: tags <URL> [接頭辞]` の次の行で固定したバージョン。

    接頭辞は、`wrangler@4.1.0` のようにパッケージごとにタグを打つモノレポで、バージョンより前の部分を書く。
    """

    def __init__(self, rel, line, url, prefix, m, apply):
        self.url = url
        self.prefix = prefix or ""
        self.name, self.current = m.groups()
        self.apply = apply
        super().__init__(f"tag:{rel}:{self.name}:{url}", self.name, rel, line)
        if self.name not in INSTALLED_VERSIONS and self.name not in CHECKED_AS_TOOL:
            self.problem = f"no reader for the installed version (add {self.name} to INSTALLED_VERSIONS in dotfiles)"

    def installed(self):
        # 判定と確かめなかった理由で 2 回呼ぶ。シェルを開くたびに流れるので、読むのは 1 回にする。
        if not hasattr(self, "_installed"):
            self._installed = INSTALLED_VERSIONS[self.name]()
        return self._installed

    def fetch(self):
        # 入っていないものの取得に失敗しても、このマシンには関係が無い。取得しなければ失敗の通知も出ない。
        if self.problem or self.name in CHECKED_AS_TOOL or self.installed() is None:
            return {}
        return self.latest()

    def latest(self):
        """公開から PIN_COOLDOWN を過ぎた最新を {"latest", "published"} で返す。入っているかに依らず取りに行く。"""
        out = run(["git", "ls-remote", "--tags", "--refs", self.url], FETCH_TIMEOUT)[0]
        tags = set(re.findall(rf"refs/tags/({re.escape(self.prefix)}v?\d+(?:\.\d+)+)$", out, re.MULTILINE))
        if not tags:
            raise FetchError("no version tag found")
        github = GITHUB_URL.match(self.url)
        if not github:
            latest, published = max(tags, key=version_key), None
        else:
            latest, published = settled_tag(*github.groups(), tags)
        return {"latest": latest and latest.removeprefix(self.prefix), "published": published}

    def skipped(self, data):
        if self.name in CHECKED_AS_TOOL:
            # ツールの節は入っていないものを出さないので、ここで入っていないことを言う。
            return "not installed" if Nvm.locate() is None else f"checked as {CHECKED_AS_TOOL[self.name]} under tools"
        if self.installed() is None:
            return "not installed"
        # 入っていなかったときの取得の結果には最新が無い。そのまま ✓ にすると確かめたように読める。
        if "latest" not in data:
            return "not fetched yet"
        return None

    def evaluate(self, data):
        latest = data.get("latest")
        if latest is None or self.name in CHECKED_AS_TOOL:
            return None
        installed = self.installed()
        if installed is not None and version_key(installed) is None:
            raise ValueError(f"cannot parse the installed version: {installed!r}")
        if installed is None or version_key(installed) >= version_key(latest):
            return None
        summary = f"{self.name} {installed} → {latest}"
        when = f" (released {data['published'][:10]})" if data.get("published") else " (release date unknown)"
        # ロールは固定したバージョンを入れるので、固定が古ければ上げてから流す。
        if version_key(self.current) < version_key(latest):
            pinned, commands = latest, [f"set {self.name} to {latest} in {self.where}", self.apply]
        else:
            pinned, commands = self.current, [self.apply]
        if self.name in AFTER_APPLY:
            commands += AFTER_APPLY[self.name](pinned)
        return notice(summary + when, summary, commands)


def find_pins(repo):
    files = []
    for root, dirs, names in os.walk(os.path.join(repo, DEPLOYED_PATH)):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        files += [os.path.join(root, n) for n in names if n.endswith((".yml", ".yaml"))]

    apply = apply_command(repo)
    found = []
    for path in sorted(files):
        rel = os.path.relpath(path, repo)
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.read().splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        for i, text in enumerate(lines):
            marker = TAG_MARKER.search(text)
            if marker:
                target = KEY_VALUE.match(lines[i + 1]) if i + 1 < len(lines) else None
                found.append(
                    TagPin(rel, i + 2, *marker.groups(), target, apply)
                    if target
                    else BrokenPin(
                        rel, i + 1, 'cannot read the version on the line after the marker (write it as key: "vX.Y.Z")'
                    )
                )
    return found


def check_pins(repo, remote=None):
    section = {"label": "pins", "items": [], "failures": [], "note": None}
    if repo is None:
        section["note"] = "checkout not found"
        return section
    if remote and count(repo, f"HEAD..{remote}", DEPLOYED_PATH):
        # 古いファイルを見て直すよう勧めると、上流で直した変更とぶつかる。
        section["note"] = "checkout is behind origin; pull first"
        return section
    cache = read_json(PINS_FILE) or {}
    # キーは checkout からの相対パスなので、別の checkout の結果でも当てはまってしまう。
    entries = (cache.get("pins") or {}) if cache.get("repo") == repo else {}
    section["items"], section["failures"] = evaluate_all(find_pins(repo), entries)
    return section


# ---------------------------------------------------------------- 取得


def long_failure(state):
    """失敗が FETCH_FAILURE_NOTICE_AFTER 以上続いていれば (日数, 理由) を返す。"""
    if not state.get("error"):
        return None
    try:
        elapsed = time.time() - float(state["failing_since"])
    except (TypeError, KeyError, ValueError):
        return None
    if elapsed < FETCH_FAILURE_NOTICE_AFTER:
        return None
    return int(elapsed // (24 * 60 * 60)), state["error"]


def brief(error):
    """シェルを開くたびに出す通知に向けて、取得の失敗の理由を短くする。全文は dotfiles check で見られる。"""
    if "CERTIFICATE_VERIFY_FAILED" in error:
        return "TLS certificate verification failed"
    if "timed out" in error:
        return "timed out"
    if "nodename nor servname" in error or "Name or service not known" in error:
        return "cannot resolve the host"
    text = re.sub(r"\s*https?://\S+\s*", " ", error).strip()
    return text if len(text) <= 60 else text[:59] + "…"


def summarize_failures(failures):
    """長く続いている取得の失敗を 1 行にまとめる。"""
    if len(failures) == 1:
        f = failures[0]
        return f"{f['label']}: fetch failing for {f['days']}d ({brief(f['error'])})"
    reasons = {brief(f["error"]) for f in failures}
    reason = reasons.pop() if len(reasons) == 1 else "see dotfiles check"
    return (
        f"{failures[0]['label']} and {len(failures) - 1} more: "
        f"fetch failing for {min(f['days'] for f in failures)}d+ ({reason})"
    )


def attempt(fetch):
    """(結果, 失敗の理由) を返す。"""
    try:
        return fetch(), None
    except FetchError as e:
        return None, str(e)
    except Exception as e:  # noqa: BLE001
        # 投げると呼び出し側（refresh）の future.result() で止まり、ほかの項目の結果も使えない。
        # 想定外の失敗もその項目の理由として残す。
        return None, f"{type(e).__name__}: {e}"


def next_state(previous, data, error, started):
    previous = previous if isinstance(previous, dict) else {}
    failing_since = previous.get("failing_since") or started
    return {
        # 失敗したときは前回の結果を残す。dotfiles 本体が古い ref で判定を続けるのと揃える。
        "data": data if error is None else previous.get("data"),
        "error": error,
        "failing_since": failing_since if error else None,
    }


def needs_refresh(repo):
    state = read_json(REFRESH_FILE)
    try:
        age = time.time() - float(state["at"])
    except (TypeError, KeyError, ValueError):
        return True
    if state.get("repo") != repo:
        return True
    return age < 0 or age >= (RETRY_INTERVAL if state.get("error") else REFRESH_INTERVAL)


def refresh(wait):
    """リモートを取得し、結果を REFRESH_FILE・TOOLS_FILE・PINS_FILE に残す。dotfiles の取得に失敗したら理由を返す。

    wait が偽なら、別のプロセスが取得中か、取得が要らなくなっていれば何もせずに None を返す。
    wait が真なら、lock を待つ間に別のプロセスが取得を済ませれば、それを使って None を返す。
    """
    os.makedirs(CACHE_DIR, exist_ok=True)
    requested = time.time()
    if not wait and updating():
        # 取得の git fetch や brew outdated が、更新中の pull や brew upgrade とぶつかる。次に開くシェルで取得する。
        return None
    with open(LOCK_FILE, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return None
        repo, _ = locate()
        previous = read_json(REFRESH_FILE) or {}
        same_repo = previous.get("repo") == repo
        if not wait and not needs_refresh(repo):
            return None
        if (
            wait
            and same_repo
            and not previous.get("error")
            and isinstance(previous.get("at"), (int, float))
            and previous["at"] >= requested
        ):
            return None
        failing_since = previous.get("failing_since") if same_repo else None
        started = time.time()
        # 取得前に試行を記録する。並んで起動した notify が同じ取得を重ねて始めないため。
        # 途中で落ちたときは失敗扱いになり、RETRY_INTERVAL 後に再試行される。
        write_json(
            REFRESH_FILE,
            {
                "repo": repo,
                "at": started,
                "error": "fetch did not finish",
                "failing_since": failing_since or started,
            },
        )

        tools = find_tools()
        pins = find_pins(repo) if repo else []
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            dotfiles = pool.submit(attempt, lambda: fetch_dotfiles(repo)) if repo else None
            fetched = {tool.key: pool.submit(attempt, tool.fetch) for tool in tools}
            fetched_pins = {pin.key: pool.submit(attempt, pin.fetch) for pin in pins}
        # checkout が無いのは取得の失敗ではない。失敗として数えると毎時の再試行と「N 日取得できていない」になる。
        error = dotfiles.result()[1] if dotfiles else None

        old = (read_json(TOOLS_FILE) or {}).get("tools") or {}
        write_json(
            TOOLS_FILE,
            {
                "at": time.time(),
                "tools": {key: next_state(old.get(key), *future.result(), started) for key, future in fetched.items()},
            },
        )
        old_pins = read_json(PINS_FILE) or {}
        old = (old_pins.get("pins") or {}) if old_pins.get("repo") == repo else {}
        write_json(
            PINS_FILE,
            {
                "repo": repo,
                "at": time.time(),
                "pins": {
                    key: next_state(old.get(key), *future.result(), started) for key, future in fetched_pins.items()
                },
            },
        )
        write_json(
            REFRESH_FILE,
            {
                "repo": repo,
                "at": time.time(),
                "error": error,
                "failing_since": (failing_since or started) if error else None,
            },
        )
        # 取得で見つかった更新を、次に開くシェルで聞けるようにする。
        sync_pending(update_groups(check_dotfiles(), check_tools()))
        return error


def updating():
    with open(UPDATE_LOCK_FILE, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
    return False


def fetch_failure(repo):
    state = read_json(REFRESH_FILE)
    if not state or state.get("repo") != repo:
        return None
    failure = long_failure(state)
    return f"remote fetch failing for {failure[0]}d ({brief(failure[1])})" if failure else None


def spawn_refresh():
    # 出力を親から切り離す。継承すると、フックの stdout のパイプや p10k の一時ファイルを
    # 取得が終わるまで握り続ける。
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "refresh"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )


# ---------------------------------------------------------------- 表示


def print_notice(found):
    print(f"  ✗ {found['summary']}")
    for command in found["commands"]:
        print(f"      {command}")


def run_check():
    """結果を表示し、(更新があるか, 判定できなかったものがあるか) を返す。"""
    if sys.stderr.isatty():
        # brew outdated が brew update を走らせると数十秒かかり、その間は何も表示されない。
        print("Fetching…", file=sys.stderr)
    fetch_error = refresh(wait=True)
    dotfiles = check_dotfiles()
    tools = check_tools(remarks=True)
    updates = unknown = False

    print(f"dotfiles ({shown(dotfiles['where']) if dotfiles['where'] else 'unknown'})")
    if dotfiles["error"]:
        print(f"  ✗ cannot check: {dotfiles['error']}")
        unknown = True
    else:
        if fetch_error:
            print(f"  ! fetch failed, used the last result: {fetch_error}")
            unknown = True
        for warning in dotfiles["warnings"]:
            print(f"  ! {warning}")
            unknown = True
        for found in dotfiles["notices"]:
            print_notice(found)
            updates = True
        if not dotfiles["notices"]:
            print("  ? up to date as far as known locally" if unknown else "  ✓ up to date")

    pins = check_pins(dotfiles["where"], dotfiles["remote"])
    for section, empty in ((tools, "no tools installed"), (pins, "no pins")):
        found_updates, found_unknown = print_items(section, empty)
        updates |= found_updates
        unknown |= found_unknown
    if update_groups(dotfiles, tools):
        print("\nUpdate: dotfiles update")
    return updates, unknown


def print_items(section, empty):
    """節を表示し、(更新があるか, 判定できなかったものがあるか) を返す。"""
    updates = unknown = False
    print(section["label"])
    if section.get("note"):
        print(f"  - {section['note']}")
    elif not section["items"]:
        print(f"  - {empty}")
    for item in section["items"]:
        if item["problem"]:
            print(f"  ! {item['label']}: {item['problem']}")
            unknown = True
        if item["notice"]:
            print_notice(item["notice"])
            updates = True
        elif item["problem"]:
            # 前回の結果は残しているが、確かめていない理由や ✓ まで出すと今回も確かめたように読める。
            continue
        elif item["skipped"]:
            print(f"  - {item['label']}: {item['skipped']}")
        else:
            print(f"  ✓ {item['label']}")
        if item.get("remark"):
            print(f"  - {item['label']}: {item['remark']}")
    return updates, unknown


# p10k の見た目に揃える。.p10k.zsh の POWERLEVEL9K_BACKGROUND（236）と区切り（ / ）、
# .zshrc の SPROMPT や補完のメッセージで使っている色とアイコンと同じものを使う。
PL_BG = "\033[48;5;236m"
PL_END = "\033[0m\033[38;5;236m\ue0b0\033[0m"
PL_SEP = " \033[38;5;244m\ue0b1\033[38;5;007m "
PL_DEFAULT = "\033[38;5;007m"
PL_COLORS = {
    "warn": "\033[38;5;003m",
    "error": "\033[38;5;001m",
    "update": "\033[38;5;014m",
    "info": "\033[38;5;245m",
    "ok": "\033[38;5;002m",
    "progress": "\033[38;5;014m",
}
PL_ICONS = {
    "dotfiles": "\ue0a0",
    "tools": "\uf0ad",
    "pins": "\uf08d",
    "warn": "\uf071",
    "info": "\uf05a",
    "ok": "\uf00c",
    "question": "\uf059",
}
NOTIFY_FOOTER = "Details: dotfiles check"
UPDATE_FOOTER = "Details: dotfiles check / Update: dotfiles update"


def notify_rows(repo, dotfiles, tools):
    """通知に出す行を (アイコン, 色, 見出し, 項目) の並びで返す。"""
    label = dotfiles["label"]
    rows = [("warn", "error", label, [dotfiles["error"]])] if dotfiles["error"] else []
    rows += [("dotfiles", "warn", label, [n["summary"]]) for n in dotfiles["notices"]]
    rows += [("warn", "warn", label, [w]) for w in dotfiles["warnings"]]
    failure = fetch_failure(repo)
    if failure:
        rows.append(("warn", "error", label, [failure]))
    for icon, title, section in (
        ("tools", "tool updates", tools),
        ("pins", "pin updates", check_pins(repo, dotfiles["remote"])),
    ):
        shorts = [item["notice"]["short"] for item in section["items"] if item["notice"]]
        if shorts:
            # シェルを開くたびに出るので、節ごとに 1 行にまとめる。
            rows.append((icon, "update", title, shorts))
        if section["failures"]:
            rows.append(("warn", "error", section["label"], [summarize_failures(section["failures"])]))
    return rows


def render_plain(rows, footer=None):
    lines = []
    for _, color, title, items in rows + ([("info", "info", footer, [])] if footer else []):
        if color == "info":
            lines.append(f"  {title}")
            continue
        mark = {"ok": "✓", "progress": "▶"}.get(color, "⚠")
        lines.append(f"{mark} {title}: {', '.join(items)}" if items else f"{mark} {title}")
    return "\n".join(lines)


def render_powerline(rows, footer=None):
    """Nerd Font（fonts ロールが入れる MesloLGS NF）の記号と 256 色で描く。"""
    lines = []
    for icon, color, title, items in rows + ([("info", "info", footer, [])] if footer else []):
        if color == "info":
            lines.append(f"{PL_BG}{PL_COLORS['info']} {PL_ICONS[icon]} {title} {PL_END}")
            continue
        body = "".join(PL_SEP + item.replace(" → ", " \uf061 ") for item in items)
        lines.append(f"{PL_BG}{PL_COLORS[color]} {PL_ICONS[icon]} {PL_DEFAULT}{title}{body} {PL_END}")
    return "\n".join(lines)


def render(rows, style, footer=None):
    return render_powerline(rows, footer) if style == "powerline" else render_plain(rows, footer)


def run_notify(fmt, style="plain"):
    try:
        repo, _ = locate()
        if needs_refresh(repo):
            spawn_refresh()
        dotfiles, tools = check_dotfiles(), check_tools()
        rows = notify_rows(repo, dotfiles, tools)
        groups = update_groups(dotfiles, tools)
        sync_pending(groups)
    except Exception as e:  # noqa: BLE001
        # 黙ると利用者は dotfiles check を実行する理由が無く、壊れたまま気づけない。
        rows, groups = [("warn", "error", "dotfiles notify", [f"failed ({type(e).__name__})"])], []
    if not rows:
        return 0
    footer = UPDATE_FOOTER if groups else NOTIFY_FOOTER
    if fmt == "claude":
        # stdout の素のテキストは Claude のコンテキストに入る。systemMessage は利用者にだけ見える。
        # Claude Code の画面は色を出さず、フォントに Nerd Font の記号があるとも限らないので文字だけで書く。
        print(json.dumps({"systemMessage": render_plain(rows, footer)}, ensure_ascii=False))
    else:
        print(render(rows, style, footer))
    return 0


# ---------------------------------------------------------------- 更新
#
# 更新できるものを 3 つに分けて聞き、選ばれたものの手順を実行する。固定バージョンは、固定が古ければ
# リポジトリを直す必要があり、固定が最新ならプレイブックを流すだけで dotfiles 本体の適用と重なるので含めない。


UPDATE_GROUPS = [
    ("dotfiles", "d", "dotfiles", "dotfiles"),
    ("tools", "t", "tools", "tools"),
    ("brew", "b", "Homebrew", "tools"),
]
# 質問の選択肢に添える。Homebrew はバージョンの公開日時を持たず、待ち期間なしで上げる。Claude Code も待たないが、
# 起動すれば自分で上がるバージョンへ上げるだけなので、ツールには添えない。
UPDATE_NOTES = {"brew": "no cooldown"}


def update_groups(dotfiles, tools):
    """更新できるものを、実行する順にグループの dict で返す。"""
    found = [n for n in dotfiles["notices"] if n["steps"]], [], []
    for item in tools["items"]:
        if item["notice"] and item["notice"]["steps"]:
            found[2 if item["key"] == "brew" else 1].append(item["notice"])
    return [
        {
            "id": gid,
            "letter": letter,
            "title": title,
            "icon": icon,
            "notices": notices,
            "keys": [k for n in notices for k in n["keys"]],
        }
        for (gid, letter, title, icon), notices in zip(UPDATE_GROUPS, found)
        if notices
    ]


def ask_policy():
    """changed（断った内容が変わるまで聞かない）、always（毎回聞く）、never（聞かない）。"""
    value = os.environ.get("DOTFILES_UPDATE_ASK", "")
    return value if value in ("always", "never") else "changed"


def askable(groups, declined):
    policy = ask_policy()
    if policy == "never":
        return []
    return [g for g in groups if policy == "always" or not set(g["keys"]) <= declined]


def read_declined():
    keys = (read_json(UPDATE_DECLINED_FILE) or {}).get("keys")
    return {k for k in keys if isinstance(k, str)} if isinstance(keys, list) else set()


def sync_pending(groups, declined=None):
    """断った記録を今の内容に合わせ、聞くことがあるかを UPDATE_PENDING_FILE に残す。"""
    declined = read_declined() if declined is None else declined
    # 今は無いものの記録は捨てる。手で上げた項目の記録が残り続けないようにする。
    kept = declined & {k for g in groups for k in g["keys"]}
    if kept != declined:
        write_json(UPDATE_DECLINED_FILE, {"keys": sorted(kept)})
    content = " ".join(g["id"] for g in askable(groups, kept))
    try:
        with open(UPDATE_PENDING_FILE, encoding="utf-8") as f:
            current = f.read()
    except OSError:
        current = None
    # シェルを開くたびに呼ばれるので、変わったときだけ書く。
    if current != content and (current is not None or content):
        write_text(UPDATE_PENDING_FILE, content)


def record_declined(groups):
    keys = read_declined() | {k for g in groups for k in g["keys"]}
    write_json(UPDATE_DECLINED_FILE, {"keys": sorted(keys)})


def typed_ahead():
    """改行まで打たれた入力が読まれずに残っているか。端末は行単位で渡すので、打ちかけの行は数えない。"""
    import select

    return bool(select.select([sys.stdin], [], [], 0)[0])


def ask(groups, style, startup):
    """選ばれたグループを返す。n なら []、Enter や Ctrl-C など答えを得られなければ None。"""
    import termios

    choices = [
        (g["letter"], g["title"] + (f" ({UPDATE_NOTES[g['id']]})" if g["id"] in UPDATE_NOTES else "")) for g in groups
    ]
    if len(groups) > 1:
        choices.append(("a", "all"))
    choices += [("n", "none"), ("Enter", "later")]
    if style == "powerline":
        body = "".join(f"{PL_SEP}{PL_COLORS['update']}{letter}{PL_DEFAULT} {title}" for letter, title in choices)
        prompt = f"{PL_BG}{PL_COLORS['update']} {PL_ICONS['question']} {PL_DEFAULT}Update?{body} {PL_END} "
    else:
        prompt = "? Update? " + ", ".join(f"{letter} = {title}" for letter, title in choices) + ": "
    letters = "".join(g["letter"] for g in groups)
    for _ in range(3):
        # 質問が出る前に打たれたキー（開いてすぐの Enter や、端末が起動時に送るコマンド）を答えにしない。
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
        try:
            answer = re.sub(r"[\s,]", "", input(prompt).lower())
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        if answer == "":
            return None
        if answer == "n":
            return []
        if answer == "a":
            return groups
        if set(answer) <= set(letters):
            return [g for g in groups if g["letter"] in answer]
        decline = "skip until it changes" if startup else "skip"
        print(f"Type any of {', '.join(letters)} (e.g. {letters}); a = all, n = {decline}, Enter = later")
    return None


# 更新中は子の出力の末尾をこの行数だけ見せる。失敗したら、原因を追えるよう長めに残す。
LIVE_LINES = 5
FAILURE_LINES = 30
# 改行の無い出力が延々と続いても、溜める量をこれで抑える。
PARTIAL_MAX = 4096
# 出力を消しても後から読めるよう、最後の update の全文をここに残す。
UPDATE_LOG_FILE = os.path.join(CACHE_DIR, "update.log")
# 最後の選択肢は、ESC [ の後に終端が来ないもの（ansible の clear_line が書く ESC [ CR）の [ まで落とす。
ESCAPE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[()][0-9A-Za-z]|\x1b[=>78]|\x1b\[?")
# パスワードのプロンプトを /dev/tty に直接書くので窓にしない。
UNWINDOWED = {"sudo"}


def printable(text):
    """エスケープ列と制御文字を落とす。"""
    import unicodedata

    return "".join(c for c in ESCAPE.sub("", text).expandtabs(4) if unicodedata.category(c) not in ("Cc", "Cf"))


def clip(text, width):
    """端末の幅に収まるよう切る。全角は 2 桁と数える。"""
    import unicodedata

    out, used = [], 0
    for c in text:
        w = 0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
        if used + w > width:
            return "".join(out[:-1]) + "…" if out else ""
        out.append(c)
        used += w
    return "".join(out)


def terminal_mode():
    """(行編集, エコー, 出力の改行の変換) が有効か。端末でなければ None。"""
    import termios

    try:
        attrs = termios.tcgetattr(sys.stdin.fileno())
    except (termios.error, OSError, ValueError):
        return None
    return bool(attrs[3] & termios.ICANON), bool(attrs[3] & termios.ECHO), bool(attrs[1] & termios.OPOST)


def awaiting_input(mode):
    """子が端末の設定を変えた後の mode が、入力を待つときの形か。

    ansible の pause は tty.setraw で出力の変換まで外し、sudo や getpass は行編集を残してエコーだけを切る。
    Homebrew はサンドボックスの子を擬似端末で流す間、出力の変換を残したまま raw にする（入力の素通しで、
    出力は Homebrew の stdout から来る）ので、これは入力待ちとみなさない。
    """
    line_editing, echo, output_processing = mode
    return not output_processing or (line_editing and not echo)


class Live:
    """子の出力の末尾を数行だけ描き直す。終わったら erase で消す。

    子が端末を使い始めたら（raw にする、エコーを切る、利用者が何か打つ）描き直しをやめて凍結し、
    子の出力をそのまま流す。端末の設定で入力待ちと分かって凍結したときは、設定が戻ってから子が
    出力を続けたら、プロンプトの下に窓を描き直す。凍結した窓や窓より下に何かが出たら dirty にする。
    dirty なら、見出しの行を結果で置き換えられない。
    """

    def __init__(self, log=None):
        import collections

        self.tail = collections.deque(maxlen=FAILURE_LINES)
        self.partial = ""
        # 受け取った行の数と、そのうち画面に出した行の数。凍結するとき、間引いて出していない行を書き足す。
        self.fed = self.shown = 0
        self.drawn = 0
        self.last_draw = 0.0
        self.stale = False
        self.dirty = False
        self.frozen = False
        # 端末の設定で入力待ちと分かって凍結したか。改行の無いプロンプトや先打ちでは、入力の終わりが分からない。
        self.prompted = False
        self.line_open = False
        self.mode = None
        self.log = log
        # 行数の少ない端末では、窓が画面からはみ出して戻れなくなる。
        self.height = max(1, min(LIVE_LINES, (shutil.get_terminal_size().lines or 24) - 2))

    def feed(self, text):
        # つないでから行に分けて除く。chunk の境目で切れたエスケープ列が残らないようにする。
        lines = (self.partial + text).split("\n")
        for line in lines[:-1]:
            # 進み具合の表示は \r で同じ行を書き直す。最後に書かれたものだけを残す。
            self.tail.append(printable(line.rstrip("\r").rsplit("\r", 1)[-1]))
            self.fed += 1
        self.partial = lines[-1][-PARTIAL_MAX:]

    def write(self, text):
        sys.stdout.write(text)
        sys.stdout.flush()

    def interrupted(self):
        """描き直すと表示を壊す状態なら凍結して真を返す。子が端末の設定を変えたか、利用者が何か打ったとき。"""
        now = terminal_mode() if self.mode is not None else None
        if now is not None and now != self.mode and awaiting_input(now):
            # 孫が /dev/tty に直接書いたプロンプト（sudo の Password: など）の後ろに続けて書かない。
            self.freeze(newline=True)
            self.prompted = True
        elif typed_ahead():
            self.freeze()
        return self.frozen

    def draw(self, force=False):
        if self.frozen or self.interrupted():
            return
        now = time.monotonic()
        # brew などは大量に出すので、描き直しを間引いてちらつきを抑える。間引いた分は run が後で描く。
        if not force and now - self.last_draw < 0.05:
            self.stale = True
            return
        self.last_draw, self.stale = now, False
        width = max((shutil.get_terminal_size().columns or 80) - 3, 10)
        # 改行の無い行は描かない。入力待ちのプロンプトなら、打った文字が窓の下に出て戻る位置がずれる。
        shown = list(self.tail)[-self.height :]
        # 幅の数え違いがあっても折り返さないよう、描く間は自動の折り返しを止める。戻るのは描いた行数だけでよい。
        lines = "".join(f"\033[2m  {clip(line, width)}\033[0m\r\n" for line in shown)
        self.write(self.erase_sequence() + "\033[?7l" + lines + "\033[?7h")
        self.drawn, self.shown = len(shown), self.fed

    def erase_sequence(self):
        sequence = f"\r\033[{self.drawn}A\033[J" if self.drawn else ""
        self.drawn = 0
        return sequence

    def erase(self):
        self.write(self.erase_sequence())

    def freeze(self, newline=False):
        """描き直しをやめる。窓は消さない（子や孫が端末に直接書いたプロンプトを消さないため）。

        間引いてまだ出していない行（プロンプトの直前の行やプロンプトそのもの）は、窓の下に書き足す。
        子が端末を raw にしていても崩れないよう、行は \r\n で終える。
        """
        unseen = list(self.tail)[-(self.fed - self.shown) :] if self.fed > self.shown else []
        self.write(
            ("\r\n" if newline else "") + "".join(f"\033[2m  {line}\033[0m\r\n" for line in unseen) + self.partial
        )
        # 書き足した最後の行が改行で終わっていなければ、続く結果の行の前に改行が要る。
        self.line_open = bool(self.partial)
        self.frozen, self.dirty, self.drawn, self.shown, self.partial = True, True, 0, self.fed, ""

    def resume(self):
        """子の出力を受け取ったときに呼ぶ。入力待ちで凍結していて入力が済んでいれば、窓に戻して真を返す。

        真なら、受け取った出力は素通しせずに窓へ渡す。凍結より前の行は、失敗しても keep で出し直さない。
        """
        if not self.prompted or typed_ahead():
            return False
        now = terminal_mode()
        if now is None or awaiting_input(now):
            return False
        # 凍結の前の行は画面に出ている。失敗したときに出し直さないよう、ここからの行だけを残す。
        self.tail.clear()
        if self.line_open:
            # 窓は消すときに 1 行目の行頭から消す。凍結中に出た行の続きから描くと、その行ごと消える。
            self.write("\r\n")
        self.fed = self.shown = self.drawn = 0
        self.frozen = self.prompted = self.line_open = self.stale = False
        return True

    def keep(self):
        """消さずに末尾を残す。失敗や中断のときに原因を見せるため。"""
        if self.frozen:
            # 子の出力はそのまま画面に出ている。
            return
        self.erase()
        lines = list(self.tail) + ([printable(self.partial)] if self.partial else [])
        self.write("".join(f"\033[2m  {line}\033[0m\r\n" for line in lines[-FAILURE_LINES:]))
        self.dirty = True

    def run(self, argv, env):
        import codecs
        import select

        self.frozen, self.prompted, self.line_open, self.mode = False, False, False, terminal_mode()
        # Python の子は、stdout がパイプだとプロンプトを溜めたまま入力を待つ（ansible の pause など）。
        # git の認証のプロンプトはエコーを切らず入力待ちと見分けられないので、聞かずに失敗させる（失敗なら末尾が残る）。
        env = {**env, "PYTHONUNBUFFERED": "1", "GIT_TERMINAL_PROMPT": "0"}
        p = subprocess.Popen(argv, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        fd = p.stdout.fileno()
        decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
        while True:
            ready, _, _ = select.select([fd], [], [], 0.1)
            if ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                if self.log:
                    # 途中で止められても、そこまでの出力が残るようにする。
                    self.log.write(chunk)
                    self.log.flush()
                # 窓に戻すのは、端末の設定が戻った後に子が改行を含む出力をしたとき。getpass は設定を戻してから
                # プロンプトの後の改行を /dev/tty に書き、ansible の pause は戻す直前に入力の行を消すエスケープ列を
                # 改行なしで書く。どちらも素通しする前に窓を描くと、窓の位置がずれる。
                if self.frozen and not (b"\n" in chunk and self.resume()):
                    sys.stdout.buffer.write(chunk)
                    sys.stdout.buffer.flush()
                    self.line_open = not chunk.endswith(b"\n")
                    continue
                self.feed(decoder.decode(chunk))
                self.draw()
                continue
            if not self.frozen and not self.interrupted():
                if printable(self.partial).strip():
                    # 改行の無いまま止まった（シェルの read などのプロンプト）。色を戻すエスケープ列だけが
                    # 改行の後ろに残ることがある（zinit など）ので、見える文字があるときだけにする。
                    self.freeze()
                elif self.stale:
                    # 出力が止まったときに最後の行が描かれないままにならないようにする。
                    self.draw(force=True)
            if p.poll() is not None:
                # 子が残したバックグラウンドのプロセスがパイプを握っていると EOF が来ない。
                break
        p.stdout.close()
        code = p.wait()
        if self.line_open:
            # 続けて出す結果の行が、子の最後の行に続かないようにする。
            self.write("\r\n")
        if not self.frozen:
            self.draw(force=True)
        return code


def run_steps(steps, live=None, log=None):
    """手順を順に実行する。失敗したら残りを飛ばし、その説明を返す。Ctrl-C なら子が終わってから KeyboardInterrupt を投げる。

    live を渡すと、子の出力を末尾の数行だけ描く。渡さなければ端末にそのまま流す。log には全文を書く。
    """
    # 色や認証のプロンプトは利用者に見せるので CHILD_ENV は使わない。
    env = {**os.environ, "DOTFILES_UPDATING": "1"}
    # 要素が入った周回は、KeyboardInterrupt を投げるか、起動に失敗して return するかで必ず抜ける。
    # 周回ごとに作り直さなくても、次の周回の初めは空である。
    interrupted = []
    for display, argv in steps:
        windowed = live is not None and os.path.basename(argv[0]) not in UNWINDOWED
        if log:
            log.write(f"$ {display}{'' if windowed or live is None else ' (sent to the terminal)'}\n".encode())
            log.flush()
        if windowed:
            live.feed(f"$ {display}\n")
            live.draw(force=True)
        else:
            if live is not None:
                live.erase()
                live.dirty = True
            print(f"$ {display}", flush=True)
        # Ctrl-C の後始末は子に任せる。既定のままだと subprocess が 0.25 秒で子を SIGKILL する。
        # SIG_IGN は exec 後も引き継がれて子が止まれなくなるので、何もしないハンドラにする（exec で既定に戻る）。
        previous = signal.signal(signal.SIGINT, lambda *_: interrupted.append(True))
        try:
            code = live.run(argv, env) if windowed else subprocess.Popen(argv, env=env).wait()
        except OSError as e:
            return f"cannot start {display} ({e})"
        finally:
            signal.signal(signal.SIGINT, previous)
        if interrupted:
            raise KeyboardInterrupt
        if code != 0:
            if windowed:
                live.keep()
            return f"{display} exited with {code}"
    return None


def run_update(startup, only, style):
    """startup なら、聞いたときに 0、聞くことが無ければ何も出さずに 1 を返す。

    それ以外は 0 = 更新した（更新が無いときも）、1 = 失敗したものがある、2 = 対象を選べなかった。
    """
    os.makedirs(CACHE_DIR, exist_ok=True)
    repo, asked = None, False
    try:
        if updating():
            # 更新の途中で判定すると、上げかけの状態を見て聞くことになる。
            if startup:
                return 1
            print("another shell is updating", file=sys.stderr)
            return 2
        repo, _ = locate()
        fetch_error = None
        if not startup:
            if sys.stderr.isatty():
                print("Fetching…", file=sys.stderr)
            fetch_error = refresh(wait=True)
        dotfiles, tools = check_dotfiles(), check_tools()
        groups = update_groups(dotfiles, tools)
        if startup and not askable(groups, read_declined()):
            sync_pending(groups)
            return 1
        if startup and typed_ahead():
            # 開いてすぐ打ったコマンドは、捨てずにシェルに渡す。次のシェルでまた聞く。
            return 1
        asked = True
        return update_chosen(repo, dotfiles, tools, groups, startup, only, style, fetch_error)
    finally:
        # 聞いたシェルでは notify を出さないので、取得の起動もここで行う。更新と lock の後に回すのは、
        # 取得の git fetch や brew outdated を、選んだ pull や brew upgrade と同時に走らせないため。
        if startup and asked and needs_refresh(repo):
            spawn_refresh()


def update_chosen(repo, dotfiles, tools, groups, startup, only, style, fetch_error):
    rows = notify_rows(repo, dotfiles, tools)
    if fetch_error:
        rows.insert(
            0,
            (
                "warn",
                "error",
                dotfiles["label"],
                [f"fetch failed, used the last result ({fetch_error})"],
            ),
        )
    if rows:
        print(render(rows, style))
    if not groups:
        print("Nothing to update")
        return 0
    if only is not None:
        chosen = [g for g in groups if "all" in only or g["id"] in only]
        if not chosen:
            print("Nothing to update in the selected targets")
            return 0
    elif not sys.stdin.isatty():
        print("run in a terminal or pass --only", file=sys.stderr)
        return 2
    else:
        chosen = ask(groups, style, startup)
    if chosen is None:
        if startup:
            print(render([("info", "info", "asking again in the next shell", [])], style))
        return 0 if startup else 2
    if startup:
        # 選ばなかったものも断ったものとして扱う。毎回聞くと、上げないと決めたものを聞き続ける。
        record_declined([g for g in groups if g not in chosen])
    if not chosen:
        sync_pending(groups)
        if startup:
            message = "asking again in the next shell" if ask_policy() == "always" else "not asking until it changes"
            print(render([("info", "info", f"{message}; update anytime with dotfiles update", [])], style))
        return 0

    # 答えを待つ間は握らない。握ると、答えずに置かれたシェルがある限り、ほかのシェルで更新できない。
    # そのため同時に開いたシェルはそれぞれ聞き、同じ更新を選びうる。
    with open(UPDATE_LOCK_FILE, "w") as lock:
        # updating() は一瞬だけ取って離す。それと重なっただけで更新中と取り違えないよう、少し待って試し直す。
        for _ in range(10):
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                time.sleep(0.05)
        else:
            if startup:
                print(render([("warn", "warn", "skipped: another shell is updating", [])], style))
                return 0
            print("another shell is updating", file=sys.stderr)
            return 2
        ids, asked_keys = {g["id"] for g in chosen}, {k for g in chosen for k in g["keys"]}
        current = update_groups(check_dotfiles(), check_tools())
        # 答えを待つ間に別のシェルが上げたものは飛ばす。取得でバージョンが進んだものは、見せていないバージョンへ上げないよう飛ばす。
        remaining, changed = [], []
        for g in current:
            if g["id"] in ids:
                (remaining if set(g["keys"]) <= asked_keys else changed).append(g)
        rows = [("warn", "warn", g["title"], ["skipped: changed while waiting for the answer"]) for g in changed]
        if changed:
            rows.append(("info", "info", "retry with dotfiles update", []))
        if not remaining and not changed:
            rows.append(("info", "info", "already up to date", []))
        if rows:
            print(render(rows, style))
        if not remaining:
            sync_pending(current)
            return 2 if changed and not startup else 0
        return run_chosen(remaining, len(chosen) < len(groups), startup, style)


def run_chosen(chosen, partial, startup, style):
    """選ばれたグループの手順を順に実行する。update.lock は呼ぶ側が握っておく。

    partial は、聞いたグループのうち選ばれなかったものがあるか。
    """
    results, updated, started, done = [], set(), 0, 0
    # 端末でなければ（ログに落とすときなど）、出力を消さずにそのまま流す。カーソルを動かせない端末も同じ。
    live_output, live = sys.stdout.isatty() and os.environ.get("TERM", "dumb") != "dumb", None

    def show(row):
        results.append(row)
        print(render([row], style), flush=True)

    # 取得と同時に走らせない。取得の git fetch が ref を握っていると、pull は "cannot lock ref" で失敗する。
    # 質問の間は握らない。握ると、答えを待つシェルがある限り dotfiles check が待ち続ける。
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(LOCK_FILE, "w") as fetching, open(UPDATE_LOG_FILE, "wb") as log:
        try:
            try:
                fcntl.flock(fetching, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                print("Waiting for the background fetch…", flush=True)
                fcntl.flock(fetching, fcntl.LOCK_EX)
            for group in chosen:
                show((group["icon"], "progress", group["title"], ["updating"]))
                log.write(f"== {group['title']}\n".encode())
                started += 1
                live = Live(log) if live_output else None
                # ツールは 1 つ失敗しても残りを上げる。
                errors = [e for e in (run_steps(n["steps"], live, log) for n in group["notices"]) if e]
                if errors:
                    row = ("warn", "error", group["title"], errors)
                elif group["id"] in {g["id"] for g in update_groups(check_dotfiles(), check_tools())}:
                    # 手順が 0 で終わっても、判定が変わらなければ上がっていない。
                    row = ("warn", "warn", group["title"], ["steps finished, but updates remain"])
                else:
                    updated.add(group["id"])
                    row = ("ok", "ok", group["title"], ["updated"])
                if live is not None:
                    live.erase()
                    if not live.dirty:
                        # 出力を消したので、見出しの行を結果で置き換える。
                        sys.stdout.write("\r\033[1A\033[2K")
                show(row)
                done += 1
        except KeyboardInterrupt:
            if live is not None:
                # 子が後始末で出したものを消さない。
                live.keep()
            print()
            for i, group in enumerate(chosen[done:]):
                show(
                    (
                        "warn",
                        "error",
                        group["title"],
                        ["interrupted" if done + i < started else "not run (interrupted)"],
                    )
                )
        sync_pending(update_groups(check_dotfiles(), check_tools()))
    hints = []
    if "dotfiles" in updated:
        hints.append(("info", "info", "reload this shell with exec zsh", []))
    if startup and partial and ask_policy() == "changed":
        hints.append(("info", "info", "not asking about the rest until they change", []))
    failed = any(color not in ("ok", "progress") for _, color, _, _ in results)
    if live_output and failed:
        # 窓から消えた出力を、失敗や中断の原因を追うときに読めるようにする。
        hints.append(("info", "info", f"full log: {shown(UPDATE_LOG_FILE)}", []))
    if hints:
        print(render(hints, style))
    return 0 if startup else 1 if failed else 0


def character_names(repo):
    """選べるキャラクター。select.yml と同じく、記録から読める文字種の名前に限る。"""
    try:
        files = os.listdir(os.path.join(repo, "ansible", "roles", "claude", "files", "characters"))
    except OSError:
        return []
    return sorted(f[:-3] for f in files if f.endswith(".md") and CHARACTER_NAME.fullmatch(f[:-3]))


def chosen_character():
    try:
        with open(CHARACTER_FILE, encoding="utf-8") as f:
            m = CHARACTER_RECORD.search(f.read())
    except (OSError, ValueError):
        return None
    return m.group(1) if m else None


def run_character_show():
    repo, _ = locate()
    names = character_names(repo) if repo else []
    chosen = chosen_character()
    if chosen is None:
        current = "not chosen yet (asked on the next playbook run)"
    elif repo and chosen not in names:
        current = f"{chosen} (file missing; asked again on the next playbook run)"
    else:
        current = chosen
    print(f"current: {current}")
    if repo is None:
        print("available: unknown (checkout not found; put it at $DOTPATH or ~/.dotfiles)")
        return 2
    print(f"available: {', '.join(names)}")
    print("switch: dotfiles character set <name>")
    return 0


def run_character_set(name):
    repo, _ = locate()
    if repo is None:
        print("checkout not found (put it at $DOTPATH or ~/.dotfiles)", file=sys.stderr)
        return 2
    if not name and not sys.stdin.isatty():
        # 端末が無いと ansible の pause は聞かずに今のものを選び、まだ選んでいなければ既定を選んだことになる。
        print(f"run in a terminal or pass a name ({', '.join(character_names(repo))})", file=sys.stderr)
        return 2
    playbook_bin = ansible_playbook()
    problem = "not found" if playbook_bin is None else interpreter_problem(playbook_bin)
    if problem:
        print(
            f"ansible-playbook does not start ({problem}); rerun {shown(os.path.join(repo, 'install'))}",
            file=sys.stderr,
        )
        return 2
    # key=value で渡すと、空白や = を含む名前が別の変数になる。JSON なら 1 つの値のまま届く。
    extra = {"claude_character": name} if name else {"claude_character_prompt": True}
    argv = [playbook_bin, os.path.join(repo, "ansible", "character.yml"), "--connection=local", "-e", json.dumps(extra)]
    before = chosen_character()
    # Ctrl-C は ansible-playbook に任せる（pause の中断の確認など）。既定のままだと親が先に落ちる。
    previous = signal.signal(signal.SIGINT, lambda *_: None)
    try:
        code = subprocess.Popen(argv).wait()
    finally:
        signal.signal(signal.SIGINT, previous)
    after = chosen_character()
    if code == 0:
        print("takes effect in new sessions" if after != before else f"unchanged ({after})")
    return code


def parse_only(value):
    targets = {t.strip() for t in value.split(",") if t.strip()}
    unknown = targets - {"dotfiles", "tools", "brew", "all"}
    if not targets or unknown:
        raise argparse.ArgumentTypeError("use a comma-separated list of dotfiles, tools, brew, all")
    return targets


# ---------------------------------------------------------------- 固定値の更新
#
# bump は固定値を上げる手順を 3 つのステップに分け、どれかだけでも通しでも流せる。write は checkout の固定値を最新に
# 書き換え、pr はそれをブランチにコミットして PR を作り（--merge ならマージして既定ブランチを取り込む）、
# apply はプレイブックを流す。

BUMP_STEPS = ("write", "pr", "apply")
# PR を作った直後は CI のチェックがまだ登録されておらず、gh pr checks --watch は待たずに失敗する。
CHECKS_APPEAR_TIMEOUT = 120


class BumpError(Exception):
    """そのステップを流せない、または流したステップが失敗した。"""


def parse_steps(value):
    steps = {s.strip() for s in value.split(",") if s.strip()}
    if not steps or steps - {*BUMP_STEPS, "all"}:
        raise argparse.ArgumentTypeError("use a comma-separated list of write, pr, apply, all")
    return set(BUMP_STEPS) if "all" in steps else steps


def step(argv, repo, capture=False):
    """コマンドを表示してから流す。0 以外で終わったら BumpError を投げる。capture なら stdout を返す。"""
    print("$ " + shlex.join(argv), flush=True)
    try:
        p = subprocess.run(argv, cwd=repo, stdout=subprocess.PIPE if capture else None, text=True, check=False)
    except OSError as e:
        raise BumpError(f"cannot start {argv[0]} ({e.strerror or e})")
    if p.returncode != 0:
        raise BumpError(f"{os.path.basename(argv[0])} exited with {p.returncode}")
    return p.stdout if capture else None


def pin_form(current, latest):
    """latest を、今の固定値と同じ書き方（先頭の v の有無）にする。ロールは書いた文字列のままタグや URL に使う。"""
    bare = latest.removeprefix("v")
    return "v" + bare if current.startswith("v") else bare


def require_base(repo, remote, what):
    """既定ブランチの上で、remote と同じコミットにいなければ BumpError を投げる。"""
    base = remote.split("/", 1)[1]
    branch = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
    if branch != base:
        raise BumpError(f"{what}must run on {base} (now on {branch or 'detached HEAD'})")
    if git(repo, "rev-parse", "HEAD") != git(repo, "rev-parse", remote):
        # 配置に使う checkout なので、check_dotfiles の取り込みと同じく、手元のコミットを書き換えない形で揃える。
        raise BumpError(f"{base} is not at {remote}; run git pull --ff-only origin {base} first")


def sync_base(repo, remote):
    """既定ブランチが remote より遅れているだけなら、早送りで取り込む。"""
    base = remote.split("/", 1)[1]
    if (
        git(repo, "symbolic-ref", "--quiet", "--short", "HEAD") == base
        and git(repo, "rev-parse", "HEAD") != git(repo, "rev-parse", remote)
        and git(repo, "merge-base", "--is-ancestor", "HEAD", remote) is not None
    ):
        step(["git", "pull", "--ff-only", "origin", base], repo)


def bump_branch():
    return f"feature/pins-bump-{time.strftime('%Y%m%d')}"


def pr_preflight(repo, remote):
    """pr を流せるかを、書き換えと push の前に確かめる。"""
    require_base(repo, remote, "pr ")
    # 前に write で書き換えた固定値は通し、ほかの変更があればここで止める。
    pin_changes(repo)
    branch = bump_branch()
    if git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}") is not None or (
        git(repo, "ls-remote", "--exit-code", "--heads", "origin", f"refs/heads/{branch}") is not None
    ):
        raise BumpError(f"{branch} already exists; clean up the previous PR first")
    # gh が使えないと分かるのが push の後だと、ブランチだけがリモートに残る。
    listed = step(["gh", "pr", "list", "--state", "open", "--json", "headRefName,url"], repo, capture=True)
    try:
        prs = json.loads(listed or "[]")
    except ValueError:
        raise BumpError("cannot parse gh pr list output as JSON")
    opened = [p.get("url") for p in prs if str(p.get("headRefName", "")).startswith("feature/pins-bump-")]
    if opened:
        # 同じ固定値を上げる PR が並ぶと、どちらをマージするかで食い違う。
        raise BumpError(f"a pin bump PR is still open ({', '.join(opened)}); merge or close it first")


def bump_write(repo, names, dry_run):
    """固定値を最新に書き換え、(書き換えた [(pin, 新しい値)], 取得に失敗した数) を返す。"""
    pins = find_pins(repo)
    for pin in pins:
        if isinstance(pin, BrokenPin):
            print(f"! {pin.where}: {pin.problem}")
    tag_pins = [p for p in pins if isinstance(p, TagPin)]
    unknown = sorted(set(names) - {p.name for p in tag_pins})
    if unknown:
        raise BumpError(f"not marked pins: {', '.join(unknown)}")
    targets = [p for p in tag_pins if not names or p.name in names]
    # 固定値はマシンに依らないので、check と違って入っていないものも取りに行く。
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(lambda p: attempt(p.latest), targets))
    changes, failures = [], 0
    for pin, (data, error) in zip(targets, results):
        if error:
            failures += 1
            print(f"! {pin.name}: fetch failed ({error})")
            continue
        latest = data.get("latest")
        if latest is None:
            print(f"- {pin.name}: no version past the {PIN_COOLDOWN // (24 * 60 * 60)}-day cooldown")
            continue
        if version_key(pin.current) >= version_key(latest):
            print(f"✓ {pin.name} {pin.current}")
            continue
        new = pin_form(pin.current, latest)
        when = f" (released {data['published'][:10]})" if data.get("published") else ""
        print(f"↑ {pin.name} {pin.current} → {new}{when}  {pin.where}")
        changes.append((pin, new))
    if not dry_run:
        rewrite_pins(repo, changes)
    return changes, failures


def rewrite_pins(repo, changes):
    by_file = {}
    for pin, new in changes:
        by_file.setdefault(pin.rel, []).append((pin, new))
    for rel, items in by_file.items():
        path = os.path.join(repo, rel)
        with open(path, encoding="utf-8", newline="") as f:
            lines = f.read().splitlines(keepends=True)
        for pin, new in items:
            m = KEY_VALUE.match(lines[pin.line - 1])
            if not m or m.groups() != (pin.name, pin.current):
                raise BumpError(f"{pin.where} changed since it was read")
            start, end = m.span(2)
            lines[pin.line - 1] = lines[pin.line - 1][:start] + new + lines[pin.line - 1][end:]
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write("".join(lines))


def pin_changes(repo):
    """HEAD から書き換えた固定値を [(変数名, 前の値, 新しい値, ファイル)] で返す。

    固定値の行のほかに変更があれば BumpError を投げる。PR に説明していない変更を混ぜないため。
    """
    # 作業ツリーと HEAD が同じでも、index にだけある変更はコミットに入る。
    staged = git(repo, "diff", "--cached", "--name-only")
    if staged:
        raise BumpError(f"staged changes ({staged.splitlines()[0]}, ...); unstage them with git restore --staged first")
    changed = git(repo, "diff", "--name-only", "HEAD")
    if staged is None or changed is None:
        raise BumpError("cannot read git diff")
    pin_lines = {}
    for pin in find_pins(repo):
        if isinstance(pin, TagPin):
            pin_lines.setdefault(pin.rel, set()).add(pin.line - 1)
    found = []
    for rel in changed.splitlines():
        # git() は出力の前後の空白を落とすので、行を比べるにはそのままの中身を読む。
        shown_old = subprocess.run(
            ["git", "-C", repo, "show", f"HEAD:{rel}"], capture_output=True, text=True, env=CHILD_ENV, check=False
        )
        old = shown_old.stdout if shown_old.returncode == 0 else None
        try:
            with open(os.path.join(repo, rel), encoding="utf-8") as f:
                new = f.read()
        except (OSError, UnicodeDecodeError):
            new = None
        old_lines, new_lines = (old or "").splitlines(), (new or "").splitlines()
        differ = [i for i, (a, b) in enumerate(zip(old_lines, new_lines)) if a != b]
        if (
            old is None
            or new is None
            or len(old_lines) != len(new_lines)
            or not set(differ) <= pin_lines.get(rel, set())
        ):
            raise BumpError(f"{rel} has changes besides pin lines; commit or stash them first")
        for i in differ:
            before, after = KEY_VALUE.match(old_lines[i]), KEY_VALUE.match(new_lines[i])
            # クォートや行末のコメントだけを変えた行は、上げた固定値として PR に載せない。
            if not before or before.group(1) != after.group(1) or before.group(2) == after.group(2):
                raise BumpError(f"changes besides pin lines at {rel}:{i + 1}")
            found.append((after.group(1), before.group(2), after.group(2), rel))
    return found


def wait_checks(repo, url):
    deadline = time.time() + CHECKS_APPEAR_TIMEOUT
    while True:
        # 実行中のチェックがあると 8 で終わるが、JSON は出る。
        p = subprocess.run(
            ["gh", "pr", "checks", url, "--json", "name"], cwd=repo, capture_output=True, text=True, check=False
        )
        try:
            if p.returncode in (0, 8) and json.loads(p.stdout or "[]"):
                break
        except ValueError:
            pass
        # チェックがまだ出ていないときのほかの失敗（認証、PR が無い）は、待っても変わらない。
        if p.returncode not in (0, 8) and "no checks reported" not in p.stderr:
            lines = [line for line in p.stderr.splitlines() if line.strip()]
            raise BumpError(f"not merged: gh pr checks failed ({lines[-1] if lines else p.returncode})")
        if time.time() >= deadline:
            raise BumpError(f"not merged: no CI checks appeared within {CHECKS_APPEAR_TIMEOUT}s")
        time.sleep(5)
    try:
        step(["gh", "pr", "checks", url, "--watch", "--fail-fast"], repo)
    except BumpError:
        raise BumpError("not merged: CI failed")


def bump_pr(repo, remote, merge):
    """書き換えた固定値をブランチにコミットして PR を作る。merge ならマージして既定ブランチを取り込む。"""
    pr_preflight(repo, remote)
    changes = pin_changes(repo)
    if not changes:
        print("No pin changes to commit")
        return
    base = remote.split("/", 1)[1]
    branch = bump_branch()
    listed = "\n".join(f"- {name}: {old} → {new}" for name, old, new, _ in changes)
    subject = "chore(ansible): 固定バージョンを上げる"
    after = [command for name, _, new, _ in changes if name in AFTER_APPLY for command in AFTER_APPLY[name](new)]
    body = (
        f"公開から {PIN_COOLDOWN // (24 * 60 * 60)} 日経った最新に、固定バージョンを上げる。`dotfiles bump` が作った。\n\n"
        f"{listed}\n\n"
        "マージした後、各マシンで `dotfiles bump --steps apply` を流す（プレイブックを流し、"
        + ("続けて " + "、".join(f"`{c}`" for c in after) + " を流す）。" if after else "その後の手順は無い）。")
    )
    done = []
    try:
        step(["git", "switch", "-c", branch, remote, "--no-track"], repo)
        done.append(f"created {branch}")
        # パスを渡すと、index にほかの変更があってもこのファイルだけをコミットする。
        step(["git", "commit", "-m", subject, "-m", listed, "--", *sorted({rel for *_, rel in changes})], repo)
        done.append("committed")
        step(["git", "push", "-u", "origin", branch], repo)
        done.append("pushed")
        url = step(
            ["gh", "pr", "create", "--base", base, "--head", branch, "--title", subject, "--body", body],
            repo,
            capture=True,
        ).strip()
        print(url)
        done.append(f"opened {url}")
        if merge:
            wait_checks(repo, url)
            # --delete-branch は手元のブランチの切り替えと削除も gh に任せるので使わず、下で git に流させる。
            step(["gh", "pr", "merge", url, "--merge"], repo)
            done.append("merged")
        step(["git", "switch", base], repo)
    except BumpError as e:
        # 再実行は require_base で止まるので、続けるか戻すかは手で決める。
        raise BumpError(
            f"{e}. Done: {', '.join(done) or 'nothing'}. "
            f"To continue, run the rest by hand. To undo, run git switch {base} and git branch -D {branch}, "
            f"and if pushed, close the PR and run git push origin --delete {branch}"
        )
    if not merge:
        print(f"After merging, run dotfiles bump --steps apply ({branch} is kept locally)")
        return
    step(["git", "pull", "--rebase", "origin", base], repo)
    step(["git", "branch", "-d", branch], repo)
    # リポジトリの設定でマージと一緒に消えていることがある。
    if git(repo, "ls-remote", "--exit-code", "--heads", "origin", f"refs/heads/{branch}") is not None:
        step(["git", "push", "origin", "--delete", branch], repo)


def bump_apply(repo, remote):
    """プレイブックを流し、プレイブックだけでは入れ替わらないものの手順（AFTER_APPLY）も流す。"""
    # マージしていない固定値を入れると、このマシンだけほかのマシンとずれる。マージした後にほかのマシンで流すときは
    # 遅れているので、先に取り込む。
    sync_base(repo, remote)
    require_base(repo, remote, "apply ")
    if git(repo, "diff", "--name-only", "HEAD", "--", DEPLOYED_PATH):
        raise BumpError(f"{DEPLOYED_PATH}/ has uncommitted changes; merge them through a PR first")
    playbook_bin = ansible_playbook()
    problem = "not found" if playbook_bin is None else interpreter_problem(playbook_bin)
    if problem:
        raise BumpError(f"ansible-playbook does not start ({problem}); rerun {shown(os.path.join(repo, 'install'))}")
    if os.uname().sysname != "Darwin" and os.geteuid() != 0 and find_tool("sudo"):
        # check_dotfiles の手順と同じく、認証が残っていないと ansible は聞かずに "Missing sudo password" で失敗する。
        step(["sudo", "-v"], repo)
    step([playbook_bin, os.path.join(repo, "ansible", "playbook.yml"), "--connection=local"], repo)
    for pin in find_pins(repo):
        if not isinstance(pin, TagPin) or pin.name not in AFTER_APPLY:
            continue
        installed, error = attempt(pin.installed)
        if error:
            raise BumpError(f"{pin.name}: cannot read the installed version ({error})")
        # 入れていないマシンでは、update が入れていないプラグインを探して失敗する。
        if installed is None or version_key(installed) == version_key(pin.current):
            continue
        for command in AFTER_APPLY[pin.name](pin.current):
            step(shlex.split(command), repo)


def run_bump(names, steps, merge, dry_run):
    repo, _ = locate()
    if repo is None:
        print("checkout not found (put it at $DOTPATH or ~/.dotfiles)", file=sys.stderr)
        return 2
    usage = None
    if dry_run and steps != {"write"}:
        usage = "--dry-run works only with --steps write"
    elif names and "write" not in steps:
        usage = "variable names need write in --steps"
    elif merge and "pr" not in steps:
        usage = "--merge needs pr in --steps"
    elif {"pr", "apply"} <= steps and not merge:
        usage = "pr with apply needs --merge (otherwise this machine alone gets unmerged pins)"
    elif {"write", "apply"} <= steps and "pr" not in steps:
        usage = "write with apply needs pr and --merge (pins are applied only after merging)"
    if usage:
        print(f"dotfiles bump: {usage}", file=sys.stderr)
        return 2
    remote = default_remote(repo)
    if remote is None:
        print("dotfiles bump: origin's default branch is unknown", file=sys.stderr)
        return 2
    try:
        step(["git", "fetch", "origin"], repo)
        if {"write", "pr"} <= steps:
            # 書き換えた後に流せないと分かるより、先に止まるほうが手戻りが無い。
            pr_preflight(repo, remote)
        if "write" in steps:
            if count(repo, f"HEAD..{remote}", DEPLOYED_PATH):
                raise BumpError(f"checkout is behind {remote}; pull first to avoid conflicts with upstream bumps")
            changes, failures = bump_write(repo, names, dry_run)
            if dry_run or steps == {"write"}:
                if changes and not dry_run:
                    print("Commit and open a PR: dotfiles bump --steps pr")
                return 1 if failures else 0
            if failures:
                print("some fetches failed, so pr and later steps did not run; continue with --steps pr")
                return 1
            if not changes and not pin_changes(repo):
                print("No pins to bump")
                # マージ済みの固定値をまだ入れていないマシンもあるので、apply は流す。
                if "apply" not in steps:
                    return 0
                steps = steps - {"pr"}
        if "pr" in steps:
            bump_pr(repo, remote, merge)
        if "apply" in steps:
            bump_apply(repo, remote)
    except (BumpError, FetchError) as e:
        print(f"dotfiles bump: {e}", file=sys.stderr)
        print(
            f"current branch: {git(repo, 'symbolic-ref', '--quiet', '--short', 'HEAD') or 'detached HEAD'}",
            file=sys.stderr,
        )
        return 1
    return 0


def main():
    # サブコマンドやオプションを変えたら、zsh の補完（files/_dotfiles）も合わせる。
    parser = argparse.ArgumentParser(
        prog="dotfiles",
        description="Check and apply updates to dotfiles, its tools and pins. Also switches the Claude Code character.",
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    check_help = "Fetch and show updates. Exit: 0 = up to date, 1 = updates (even if some are unknown), 2 = unknown"
    sub.add_parser("check", help=check_help, description=check_help)
    notify = sub.add_parser(
        "notify",
        help="Notify from the last fetch; refetch in the background when stale",
    )
    notify.add_argument(
        "--format",
        choices=["text", "claude"],
        default="text",
        help="claude: JSON for the Claude Code SessionStart hook",
    )
    notify.add_argument(
        "--style",
        choices=["plain", "powerline"],
        default="plain",
        help="powerline: Nerd Font glyphs and 256 colors (text format only)",
    )
    update = sub.add_parser(
        "update",
        help=(
            "Fetch, list updates (dotfiles, tools, Homebrew) and apply the chosen ones. "
            "Exit: 0 = done or nothing to do, 1 = something failed, 2 = nothing chosen"
        ),
    )
    update.add_argument(
        "--only", type=parse_only, help="update without asking: comma-separated dotfiles, tools, brew, all"
    )
    update.add_argument(
        "--startup",
        action="store_true",
        help=(
            "for .zshrc at shell startup: no fetch; exit 0 if asked, 1 silently if nothing to ask. "
            "Declined updates are not asked again until they change. "
            "DOTFILES_UPDATE_ASK=always asks every time, never disables asking"
        ),
    )
    update.add_argument(
        "--style", choices=["plain", "powerline"], default="plain", help="powerline: Nerd Font glyphs and 256 colors"
    )
    bump = sub.add_parser(
        "bump",
        help=(
            "Bump pins to the latest release past the 7-day cooldown. "
            "write edits the checkout, pr commits and opens a PR, apply runs the playbook. "
            "Exit: 0 = done or nothing to bump, 1 = a step failed or did not run, 2 = bad arguments"
        ),
    )
    bump.add_argument(
        "names", nargs="*", metavar="NAME", help="pins to bump (e.g. awscli_version); all marked pins if omitted"
    )
    bump.add_argument(
        "--steps",
        type=parse_steps,
        default={"write"},
        help="comma-separated write, pr, apply, all (default: write)",
    )
    bump.add_argument("--merge", action="store_true", help="with pr: wait for CI, merge, and pull the default branch")
    bump.add_argument("--dry-run", action="store_true", help="with write: show bumps without editing")
    sub.add_parser("refresh", help="Fetch (notify runs this in the background)")
    character = sub.add_parser("character", help="Show the Claude Code character; switch with set")
    character_sub = character.add_subparsers(dest="character_command", metavar="<command>")
    character_set = character_sub.add_parser(
        "set", help="Switch the character (asks without a name; Enter keeps it). Takes effect in new sessions"
    )
    character_set.add_argument("name", nargs="?", help="<name> in ansible/roles/claude/files/characters/<name>.md")
    args = parser.parse_args()

    if args.command is None:
        parser.print_help(sys.stderr)
        return 2
    if args.command == "character":
        return run_character_set(args.name) if args.character_command == "set" else run_character_show()
    if args.command == "notify":
        return run_notify(args.format, args.style)
    if args.command == "refresh":
        refresh(wait=False)
        return 0
    if args.command == "bump":
        return run_bump(args.names, args.steps, args.merge, args.dry_run)
    if args.command == "update":
        try:
            return run_update(args.startup, args.only, args.style)
        except KeyboardInterrupt:
            # 質問の前に止められたときは何も出ていないので、notify にいつもの通知を出させる。
            print()
            return 1 if args.startup else 2
        except Exception as e:  # noqa: BLE001
            if args.startup:
                # シェルを開くたびにトレースバックを出さない。1 を返して、続く notify にいつもの通知を出させる。
                print(f"dotfiles update failed ({type(e).__name__}: {e})")
                return 1
            traceback.print_exc()
            return 2
    try:
        updates, unknown = run_check()
    except Exception:  # noqa: BLE001
        # 1 は「更新あり」の意味なので、想定外の失敗をそれと区別する。
        traceback.print_exc()
        return 2
    return 1 if updates else 2 if unknown else 0


if __name__ == "__main__":
    sys.exit(main())
