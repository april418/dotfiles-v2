def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def write_json(path, data):
    write_text(path, json.dumps(data, ensure_ascii=False))


def write_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def shown(path):
    """コマンド例にそのまま貼れる形にする。"""
    if path.startswith(HOME + os.sep):
        # ~ はクォートの内側に入れると展開されない。
        return "~/" + shlex.quote(path[len(HOME) + 1:])
    return shlex.quote(path)


def version_key(text):
    """'v0.40.8' や '0.12.14' を大小比較できる形にする。数字を含まなければ None。"""
    numbers = re.findall(r"\d+", text or "")
    return tuple(int(n) for n in numbers) if numbers else None


def find_tool(name):
    found = shutil.which(name)
    if found:
        return found
    for directory in KNOWN_BIN_DIRS:
        path = os.path.join(directory, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def notice(summary, short, commands, details=None, steps=None, keys=None):
    """details は issue にだけ載せる補足（差分など）。

    steps は update が実行する (表示, argv) の並び。渡さなければ update の対象にしない。
    keys は断られた内容と比べる値の並びで、省くと summary だけ。summary に件数しか出ないものは、
    取り込み先の版や SHA を渡す。件数だと、上げた後に同じ件数の更新が来たときに断ったものと区別できない。
    """
    return {
        "summary": summary, "short": short, "commands": commands, "details": details,
        "steps": steps or [], "keys": keys or [summary],
    }


# ---------------------------------------------------------------- dotfiles 本体


def label(repo):
    if repo and os.path.realpath(repo) != os.path.realpath(DEFAULT_REPO):
        return f"dotfiles ({shown(repo)})"
    return "dotfiles"


def locate():
    """(checkout のルート, 適用記録) を返す。

    適用記録が別の checkout のものなら None にする。見つからなければ (None, None)。
    """
    applied = read_json(APPLIED_FILE)
    if applied and not (isinstance(applied.get("repo"), str) and isinstance(applied.get("commit"), str)):
        applied = None
    candidates = [applied["repo"]] if applied else []
    if os.environ.get("DOTPATH"):
        candidates.append(os.environ["DOTPATH"])
    candidates.append(DEFAULT_REPO)
    for candidate in candidates:
        if not os.path.isdir(candidate):
            continue
        top = git(candidate, "rev-parse", "--show-toplevel")
        if top:
            if applied and os.path.realpath(applied["repo"]) != os.path.realpath(top):
                applied = None
            return top, applied
    return None, None


def count(repo, revs, *paths):
    out = git(repo, "rev-list", "--count", "--no-merges", revs, "--", *paths)
    return int(out) if out is not None else None


def ansible_playbook():
    """プレイブックを流す ansible-playbook。install と同じく ~/.local/bin のものを先に使う。"""
    path = os.path.join(HOME, ".local", "bin", "ansible-playbook")
    return path if os.access(path, os.X_OK) else find_tool("ansible-playbook")


def interpreter_problem(path):
    """スクリプトの先頭行が指すインタープリターが無ければ、その説明を返す。"""
    try:
        with open(path, "rb") as f:
            head = f.read(1024).decode("utf-8", "replace").splitlines()
    except OSError as e:
        return f"{shown(path)} を読めない（{e.strerror}）"
    if not head or not head[0].startswith("#!"):
        return None
    interpreter = head[0][2:].strip().split(" ")[0]
    # pip はパスに空白があると sh を経由する起動行を書く（pipx の ~/Library/Application Support など）。
    if os.path.basename(interpreter) == "sh" and len(head) > 1:
        m = re.match(r"'{3}exec' \"([^\"]+)\"", head[1])
        if m:
            interpreter = m.group(1)
    return None if os.path.exists(interpreter) else f"{shown(interpreter)} が無い"


def check_dotfiles():
    repo, applied = locate()
    result = {"label": label(repo), "where": repo, "notices": [], "warnings": [], "error": None, "remote": None}
    if repo is None:
        result["error"] = "checkout が見つからない（DOTPATH か ~/.dotfiles に置く）"
        return result

    playbook = os.path.join(repo, "ansible", "playbook.yml")
    apply = f"ansible-playbook {shown(playbook)} --connection=local"
    playbook_bin = ansible_playbook()
    apply_steps = [(apply, [playbook_bin or "ansible-playbook", playbook, "--connection=local"])]
    if os.uname().sysname != "Darwin" and os.geteuid() != 0 and find_tool("sudo"):
        # install と同じく先に認証を済ませる。become は macOS 以外の作業にしか無く、
        # 認証が残っていないと ansible は聞かずに "Missing sudo password" で失敗する。
        apply_steps.insert(0, ("sudo -v", ["sudo", "-v"]))
    # venv の Python が消える（Homebrew の cleanup が使われなくなった版を消すなど）と、コマンドはあっても起動しない。
    # 子プロセスを起動せずに分かる範囲で、シェルを開くたびに確かめる。
    problem = "見つからない" if playbook_bin is None else interpreter_problem(playbook_bin)
    if problem:
        result["warnings"].append(f"ansible-playbook が起動しない（{problem}）。{shown(os.path.join(repo, 'install'))} を流し直す")
        # 流しても失敗するので、update の手順にしない。pull だけを済ませても配置はされない。
        apply_steps = []
    remote = git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if remote is None:
        remote = next(
            (r for r in ("origin/main", "origin/master") if git(repo, "rev-parse", "--verify", "--quiet", r)),
            None,
        )
    result["remote"] = remote
    behind = count(repo, f"HEAD..{remote}", DEPLOYED_PATH) if remote else None
    if behind is None:
        result["warnings"].append("origin の既定ブランチを特定できないため、リモートとは比べていない")

    if behind:
        branch = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
        summary = f"{remote} より {behind} コミット遅れている"
        if branch == remote.split("/", 1)[1]:
            # 配置用の checkout にローカルのコミットがあれば、書き換えずに止める。
            pull = f"git -C {shown(repo)} pull --ff-only origin {branch}"
            commands = [pull, apply]
            steps = [(pull, ["git", "-C", repo, "pull", "--ff-only", "origin", branch])] + apply_steps if apply_steps else []
        else:
            # 作業ブランチで取り込み方を決めつけると、rebase などを勧めることになるため手順は出さない。
            summary += f"（{branch or 'detached HEAD'} を checkout 中）"
            commands = steps = []
        result["notices"].append(notice(summary, summary, commands, steps=steps, keys=[f"dotfiles:pull:{git(repo, 'rev-parse', remote)}"]))
        return result

    def apply_notice(summary):
        return notice(summary, summary, [apply], steps=apply_steps, keys=[f"dotfiles:apply:{git(repo, 'rev-parse', f'HEAD:{DEPLOYED_PATH}')}"])

    if applied is None:
        result["notices"].append(apply_notice("適用したコミットの記録が無い"))
        return result

    # 配置先の中身とは比べない。Claude Code が ~/.claude/settings.json を書き換えるため、常にずれて見える。
    commit = applied["commit"]
    if git(repo, "cat-file", "-e", f"{commit}^{{commit}}") is None:
        result["notices"].append(apply_notice("適用したコミットが checkout に無い"))
        return result
    trees = git(repo, "rev-parse", f"{commit}:{DEPLOYED_PATH}", f"HEAD:{DEPLOYED_PATH}")
    if trees is None or len(set(trees.split())) > 1:
        unapplied = count(repo, f"{commit}..HEAD", DEPLOYED_PATH)
        result["notices"].append(apply_notice(f"取り込み済みの {unapplied} コミットが未適用" if unapplied else "checkout と適用済みの内容が違う"))
    return result


def fetch_dotfiles(repo):
    run(["git", "-C", repo, *GIT_FETCH, "origin"], FETCH_TIMEOUT)


# ---------------------------------------------------------------- ツール


class Tool:
    """更新を確かめるツール。

    fetch はネットワークを使ってよく、refresh だけが呼ぶ。返した dict が evaluate と skipped に渡る。
    evaluate と skipped はシェルやセッションを開くたびに呼ばれるので、手元の状態だけで速く判定する。
    更新した直後に古い通知が残らないよう、入っている版などは毎回読み直す。
    """

    def skipped(self, data):
        """確かめなかった理由。確かめたなら None。"""
        return None


class Uv(Tool):
    key = "uv"
    label = "uv"

    def __init__(self, path):
        self.path = path
        # self update できるのは standalone のインストーラーで入れたものだけ。brew や pip で入れたものの
        # 失敗の文言はビルドごとに違うので、インストーラーが残すレシートの導入先で見分ける。
        config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
        prefix = (read_json(os.path.join(config, "uv", "uv-receipt.json")) or {}).get("install_prefix")
        self.standalone = isinstance(prefix, str) and (
            os.path.realpath(prefix) == os.path.realpath(os.path.dirname(path))
        )

    def fetch(self):
        if not self.standalone:
            return {"unsupported": True}
        try:
            stdout, stderr = run([self.path, "self", "update", "--dry-run"], FETCH_TIMEOUT)
        except FetchError as e:
            # レシートと実体が食い違うときに出る。毎回の失敗として扱うと通知が出続ける。
            if "Self-update is only available" in str(e):
                return {"unsupported": True}
            raise
        m = re.search(r"Would update uv from v?(\S+) to v?(\S+)", stdout + stderr)
        if m:
            return {"latest": m.group(2)}
        # 読めなかったものまで最新と扱うと、文言が変わったときに黙って「最新」と言い続ける。
        if re.search(r"You're (on the latest version of uv|already on version)", stdout + stderr):
            return {"latest": None}
        raise FetchError("uv self update --dry-run の出力を解釈できない")

    def skipped(self, data):
        if data.get("unsupported"):
            return "standalone のインストーラーで入れたものではないため確かめていない（入れたパッケージマネージャーで更新する）"
        return None

    def evaluate(self, data):
        if data.get("unsupported") or not data.get("latest"):
            return None
        try:
            m = re.match(r"uv (\S+)", run([self.path, "--version"], 10)[0])
        except FetchError:
            return None
        installed = m.group(1) if m else None
        if version_key(installed) is None or version_key(installed) >= version_key(data["latest"]):
            return None
        summary = f"uv {installed} → {data['latest']}"
        return notice(summary, summary, ["uv self update"], steps=[("uv self update", [self.path, "self", "update"])])


class Nvm(Tool):
    key = "nvm"
    label = "nvm"

    def __init__(self, directory):
        self.directory = directory
        self.is_git = os.path.isdir(os.path.join(directory, ".git"))

    @staticmethod
    def locate():
        # .zshenv の NVM_DIR と同じ規則。
        directory = os.environ.get("NVM_DIR") or (
            os.path.join(os.environ["XDG_CONFIG_HOME"], "nvm") if os.environ.get("XDG_CONFIG_HOME")
            else os.path.join(HOME, ".nvm")
        )
        return directory if os.path.isfile(os.path.join(directory, "nvm.sh")) else None

    def fetch(self):
        args = ["git", "-C", self.directory, "ls-remote", "--tags", "--refs", "origin"] if self.is_git \
            else ["git", "ls-remote", "--tags", "--refs", NVM_REPO_URL]
        tags = re.findall(r"refs/tags/(v\d+\.\d+\.\d+)$", run(args, FETCH_TIMEOUT)[0], re.MULTILINE)
        if not tags:
            raise FetchError("リリースのタグが見つからない")
        return {"latest": max(tags, key=version_key)}

    def evaluate(self, data):
        package = read_json(os.path.join(self.directory, "package.json")) or {}
        installed = package.get("version")
        latest = data.get("latest")
        # update はこの値をコマンドに埋めて実行するので、タグの形をしていなければ使わない。
        # 黙って捨てると最新に見えるので、判定できなかったものとして出す。
        if not isinstance(latest, str) or not re.fullmatch(r"v\d+\.\d+\.\d+", latest):
            raise ValueError(f"最新版をタグとして読めない（{latest!r}）")
        if version_key(installed) is None or version_key(installed) >= version_key(latest):
            return None
        if self.is_git:
            # install.sh は --depth=1 で clone する。README の fetch --tags だと全タグの履歴まで取りに行くので、
            # install.sh と同じく要るタグだけを取る。
            argvs = [
                ["git", "-C", self.directory, "fetch", "--depth=1", "origin", "tag", latest],
                ["git", "-C", self.directory, "checkout", latest],
            ]
            steps = [(f"git -C {shown(self.directory)} {shlex.join(argv[3:])}", argv) for argv in argvs]
        else:
            # PROFILE=/dev/null が無いと、install.sh が .zshrc に読み込み行を書き足す（.zshenv で読み込み済み）。
            # pipefail と -f が無いと、取得に失敗しても空の入力を bash が読んで 0 で終わる。
            command = f"curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/{latest}/install.sh | PROFILE=/dev/null bash"
            steps = [(command, ["bash", "-o", "pipefail", "-c", command])]
        summary = f"nvm {installed} → {latest.lstrip('v')}"
        return notice(summary, summary, [display for display, _ in steps], steps=steps)


class GitTool(Tool):
    """git で clone して更新するもの（zinit 本体とプラグイン）。"""

    def __init__(self, key, label, path, args):
        self.key = key
        self.label = label
        self.path = path
        self.args = args

    @staticmethod
    def locate():
        found = []
        core = os.path.join(ZINIT_DIR, "zinit.git")
        if os.path.isdir(os.path.join(core, ".git")):
            found.append(GitTool("zinit", "zinit", core, ["self-update"]))
        plugins = os.path.join(ZINIT_DIR, "plugins")
        for entry in sorted(os.listdir(plugins)) if os.path.isdir(plugins) else []:
            path = os.path.join(plugins, entry)
            # zinit はプラグイン user/repo を user---repo に置く。_local---zinit は git の clone ではない。
            if "---" not in entry or not os.path.isdir(os.path.join(path, ".git")):
                continue
            user, repo = entry.split("---", 1)
            found.append(GitTool(f"zinit:{user}/{repo}", repo, path, ["update", f"{user}/{repo}"]))
        return found

    def fetch(self):
        run(["git", "-C", self.path, *GIT_FETCH], FETCH_TIMEOUT)
        return {}

    def skipped(self, data):
        # ver ice などで固定していると追跡ブランチが無く、遅れを数えられない。
        if git(self.path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}") is None:
            return "追跡ブランチが無いため確かめていない"
        return None

    def evaluate(self, data):
        behind = git(self.path, "rev-list", "--count", "--no-merges", "HEAD..@{upstream}")
        if not behind or behind == "0":
            return None
        command = shlex.join(["zinit", *self.args])
        # zinit はシェル関数なので、rc を読まない zsh に読み込んで呼ぶ。
        run = ["zsh", "-fc", 'source "$1" && zinit "${@:2}"', "zsh", os.path.join(ZINIT_DIR, "zinit.git", "zinit.zsh"), *self.args]
        return notice(
            f"{self.label} に {behind} コミットの更新がある", f"{self.label}（{behind} コミット）", [command],
            steps=[(command, run)], keys=[f"{self.key}@{git(self.path, 'rev-parse', '@{upstream}')}"],
        )


class Brew(Tool):
    key = "brew"
    label = "Homebrew"

    def __init__(self, path):
        self.path = path

    def fetch(self):
        prefix = run([self.path, "--prefix"], FETCH_TIMEOUT)[0].strip()
        try:
            # 自動更新の経過は stderr に出るので、stdout だけを読む。
            outdated = json.loads(run([self.path, "outdated", "--json=v2"], BREW_TIMEOUT)[0])
        except ValueError:
            raise FetchError("brew outdated の出力を JSON として読めない")
        packages = []
        for kind, items in (("Cellar", outdated.get("formulae", [])), ("Caskroom", outdated.get("casks", []))):
            for item in items:
                # brew upgrade は pin したものを上げないので、通知しても手順が無い。
                if item.get("pinned"):
                    continue
                # tap の formula は user/tap/name で出るが、Cellar のディレクトリは name だけ。
                name = item["name"].rsplit("/", 1)[-1]
                packages.append({
                    "name": name,
                    "dir": os.path.join(prefix, kind, name),
                    "installed": item.get("installed_versions") or [],
                    "latest": item.get("current_version"),
                })
        return {"packages": packages}

    @staticmethod
    def still_outdated(package):
        # 上げると版ごとのディレクトリが増える。取得時の current_version より新しい版に上がることもあるので、
        # 取得時に入っていた版以外があるかで見る。Caskroom には .metadata もある。
        try:
            versions = [v for v in os.listdir(package["dir"]) if not v.startswith(".")]
        except OSError:
            return False
        return bool(versions) and all(v in package["installed"] for v in versions)

    def evaluate(self, data):
        remaining = [p for p in data.get("packages", []) if self.still_outdated(p)]
        if not remaining:
            return None
        names = [p["name"] for p in remaining]
        listed = "、".join(names[:5]) + (f" ほか {len(names) - 5} 件" if len(names) > 5 else "")
        return notice(
            f"Homebrew の {len(names)} パッケージに更新がある（{listed}）",
            f"Homebrew（{len(names)} 件）",
            ["brew upgrade"],
            steps=[("brew upgrade", [self.path, "upgrade"])],
            # 要約は名前しか出さないので、同じパッケージの次の版が出ても変わらない。
            keys=[f"brew:{p['name']}@{p.get('latest')}" for p in remaining],
        )


def find_tools():
    found = []
    uv = find_tool("uv")
    if uv:
        found.append(Uv(uv))
    nvm = Nvm.locate()
    if nvm:
        found.append(Nvm(nvm))
    found += GitTool.locate()
    brew = find_tool("brew")
    if brew:
        found.append(Brew(brew))
    return found


def evaluate_all(found, entries):
    """取得の結果 entries で found をそれぞれ判定し、(項目, 長く続いている失敗) を返す。"""
    items, failures = [], []
    for obj in found:
        if getattr(obj, "problem", None):
            items.append({"key": obj.key, "label": obj.label, "notice": None, "skipped": None, "problem": obj.problem})
            continue
        entry = entries.get(obj.key)
        if not isinstance(entry, dict):
            continue
        data = entry.get("data") if isinstance(entry.get("data"), dict) else None
        item = {"key": obj.key, "label": obj.label, "notice": None, "skipped": None, "problem": None}
        if entry.get("error"):
            item["problem"] = f"最新版を取得できなかった（{entry['error']}）"
        try:
            if data is not None:
                item["notice"] = obj.evaluate(data)
                item["skipped"] = obj.skipped(data)
        except Exception as e:
            # 1 つの判定の失敗で、ほかの項目や dotfiles 本体の通知まで消さない。
            item["problem"] = f"判定できなかった（{type(e).__name__}: {e}）"
        items.append(item)
        failure = long_failure(entry)
        if failure:
            failures.append({"label": obj.label, "days": failure[0], "error": failure[1]})
    return items, failures


def check_tools():
    items, failures = evaluate_all(find_tools(), (read_json(TOOLS_FILE) or {}).get("tools") or {})
    return {"label": "ツール", "items": items, "failures": failures}


# ---------------------------------------------------------------- 固定バージョン
#
# ansible/ 配下と .github/workflows の YAML を走査して、版を固定している箇所を見つける。
# 書き方は RAW_PIN・TAG_MARKER・USES_SHA の 3 つ。目印や SHA があるのに版を読めないものは、
# 黙って落とさずに問題として出す。

# 公開から日が浅い版は勧めない。pnpm の minimum-release-age と uv の exclude-newer（どちらも 1 週間）に
# 揃える。raw とリリースの無いタグはコミットの日時で測るので、日時を偽った上流の乗っ取りまでは防げない。
PIN_COOLDOWN = 7 * 24 * 60 * 60
DIFF_MAX_LINES = 200

RAW_PIN = re.compile(r"https://raw\.githubusercontent\.com/([\w.-]+)/([\w.-]+)/([0-9a-f]{40})/([^\s\"'#,\]}]+)")
TAG_MARKER = re.compile(r"#\s*dotfiles-check:\s*tags\s+(\S+)")
KEY_VALUE = re.compile(r"\s*([\w-]+):\s*[\"']?(v?\d+(?:\.\d+)+)[\"']?\s*(?:#.*)?$")
USES_SHA = re.compile(r"uses:\s*[\"']?([\w.-]+)/([\w.-]+)((?:/[\w./-]+)?)@([0-9a-f]{40})[\"']?(.*)$")
# Renovate の `# tag=vX.Y.Z` も読む。
VERSION_COMMENT = re.compile(r"#\s*(?:tag=)?(v\d+(?:\.\d+)*)\b")
GITHUB_URL = re.compile(r"https://github\.com/([\w.-]+)/([\w.-]+?)(?:\.git)?/?$")


def comment_start(line):
    """YAML のコメントが始まる位置。コメントが無ければ行の長さ。"""
    m = re.search(r"(?:^|\s)#", line)
    return m.end() - 1 if m else len(line)


def parse_time(text):
    return calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ"))


def github_api(path):
    status, body = http_get(f"{GITHUB_API}{path}", token=github_token())
    if status != 200:
        raise FetchError(f"GitHub API の {path.split('?')[0]} が HTTP {status} を返した")
    return json.loads(body)


def settled_tag(owner, name, tags):
    """tags のうち、公開から PIN_COOLDOWN を過ぎた最大の版とその公開日時を返す。どれも日が浅ければ (None, None)。"""
    releases = {r["tag_name"]: r for r in github_api(f"/repos/{owner}/{name}/releases?per_page=100")}
    lookups = 0
    for tag in sorted(tags, key=version_key, reverse=True):
        release = releases.get(tag)
        if release is not None:
            if release.get("draft") or release.get("prerelease"):
                continue
            published = release.get("published_at")
        else:
            # リリースを作らないリポジトリもある。その版のコミットの日時で代えるが、呼ぶ回数に上限を置く。
            if lookups >= 5:
                raise FetchError("公開から日が経った版を見つけられない（リリースの無い版を 5 件まで調べた）")
            lookups += 1
            published = github_api(f"/repos/{owner}/{name}/commits/{tag}")["commit"]["committer"]["date"]
        if published and time.time() - parse_time(published) >= PIN_COOLDOWN:
            return tag, published
    return None, None


def make_diff(old, new, old_name, new_name):
    lines = list(difflib.unified_diff(
        old.decode("utf-8", "replace").splitlines(), new.decode("utf-8", "replace").splitlines(),
        old_name, new_name, lineterm="",
    ))
    if len(lines) > DIFF_MAX_LINES:
        lines = lines[:DIFF_MAX_LINES] + [f"…（以下 {len(lines) - DIFF_MAX_LINES} 行を省略）"]
    return "\n".join(lines)


class Pin(Tool):
    problem = None

    def __init__(self, key, label, rel, line):
        self.key = key
        self.label = label
        self.where = f"{rel}:{line}"


class BrokenPin(Pin):
    """固定しようとしているのに版を読めない箇所。"""

    def __init__(self, rel, line, problem):
        super().__init__(f"broken:{rel}:{line}", f"{rel}:{line}", rel, line)
        self.problem = problem

    def fetch(self):
        return {}


class RawPin(Pin):
    """raw.githubusercontent.com の URL をコミット SHA で固定したもの。"""

    def __init__(self, rel, line, m, occurrence):
        self.owner, self.name, self.sha, self.file = m.groups()
        # SHA は更新で変わるので、キーには含めない。
        super().__init__(
            f"raw:{rel}:{self.owner}/{self.name}/{self.file}#{occurrence}",
            os.path.basename(os.path.dirname(self.file)) or self.file, rel, line,
        )

    def raw_url(self, ref, file=None):
        return f"https://raw.githubusercontent.com/{self.owner}/{self.name}/{ref}/{file or self.file}"

    def download(self, ref, file=None):
        status, body = http_get(self.raw_url(ref, file))
        if status != 200:
            raise FetchError(f"{ref[:7]} のファイルを取得できない（HTTP {status}）")
        return body

    def settled_commit(self, head, file):
        """既定ブランチで file を変えたコミットのうち、PIN_COOLDOWN を過ぎた最新のものの (SHA, 日時)。"""
        until = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - PIN_COOLDOWN))
        found = github_api(
            f"/repos/{self.owner}/{self.name}/commits?sha={head}&path={quote_path(file)}&until={until}&per_page=1"
        )
        return (found[0]["sha"], found[0]["commit"]["committer"]["date"]) if found else (None, None)

    def fetch(self):
        out = run(["git", "ls-remote", f"https://github.com/{self.owner}/{self.name}.git", "HEAD"], FETCH_TIMEOUT)[0]
        if not out.strip():
            raise FetchError("既定ブランチの HEAD を取得できない")
        head = out.split()[0]
        if http_get(self.raw_url(head))[0] == 404:
            return self.fetch_moved(head)
        # 既定ブランチの HEAD は毎日動くので勧めない。そのファイルを変えたコミットのうち、日が経ったものを勧める。
        suggested, date = self.settled_commit(head, self.file)
        if suggested is None or suggested == self.sha:
            return {"pinned": self.sha, "suggested": None}
        # 日の浅い版をすでに固定しているなら、古いほうへ戻すことになるので勧めない。
        pinned_date = github_api(f"/repos/{self.owner}/{self.name}/commits/{self.sha}")["commit"]["committer"]["date"]
        if parse_time(pinned_date) >= parse_time(date):
            return {"pinned": self.sha, "suggested": None}
        old, new = self.download(self.sha), self.download(suggested)
        if old == new:
            return {"pinned": self.sha, "suggested": None}
        return {
            "pinned": self.sha, "suggested": suggested, "date": date,
            "diff": make_diff(old, new, f"{self.sha[:7]}/{self.file}", f"{suggested[:7]}/{self.file}"),
        }

    def fetch_moved(self, head):
        moved = self.candidates(head)
        data = {"pinned": self.sha, "moved": moved, "suggested": None}
        if not moved:
            return data
        # 移動先でも日の浅いコミットは勧めない。HEAD を本文に入れると、上流に push があるたびに issue が変わる。
        suggested, date = self.settled_commit(head, moved[0])
        if suggested is None:
            return data
        old, new = self.download(self.sha), self.download(suggested, moved[0])
        data.update(
            suggested=suggested, date=date,
            diff=make_diff(old, new, f"{self.sha[:7]}/{self.file}", f"{suggested[:7]}/{moved[0]}"),
        )
        return data

    def candidates(self, head):
        """既定ブランチから、同じ「親ディレクトリ/ファイル名」を持つパスを探す。"""
        try:
            tree = github_api(f"/repos/{self.owner}/{self.name}/git/trees/{head}?recursive=1")
        except FetchError:
            return []
        tail = "/".join(self.file.split("/")[-2:])
        paths = [e.get("path", "") for e in tree.get("tree", [])]
        return [path for path in paths if path == tail or path.endswith("/" + tail)][:3]

    def skipped(self, data):
        if data.get("pinned") != self.sha:
            return "取得の後に固定先が変わったため、次の取得で確かめる"
        return None

    def evaluate(self, data):
        if data.get("pinned") != self.sha:
            return None
        if "moved" in data:
            moved, suggested = data["moved"], data.get("suggested")
            # 移動から日が浅い。固定先は SHA なので、待っても壊れない。
            if moved and not suggested:
                return None
            summary = f"{self.label} の固定先のパスが既定ブランチに無い"
            if moved:
                summary += f"（移動先の候補: {'、'.join(moved)}）"
                commands = [
                    f"{self.where} の URL を {self.raw_url(suggested, moved[0])} にする（{data['date'][:10]} のコミット）"
                ]
            else:
                commands = [f"移動先を確かめて {self.where} の URL を直す"]
            return notice(summary, f"{self.label}（パスが移動）", commands, details=data.get("diff"))
        suggested = data.get("suggested")
        if not suggested:
            return None
        return notice(
            f"{self.label} に更新がある（{self.sha[:7]} → {suggested[:7]}、{data['date'][:10]} のコミット）",
            self.label,
            [
                f"{self.where} の SHA を {suggested} にする",
                f"変更の履歴: https://github.com/{self.owner}/{self.name}/commits/{suggested}/{self.file}",
            ],
            details=data.get("diff"),
        )


class TagPin(Pin):
    """`# dotfiles-check: tags <URL>` の次の行で固定した版。"""

    def __init__(self, rel, line, url, m):
        self.url = url
        self.name, self.current = m.groups()
        super().__init__(f"tag:{rel}:{self.name}:{url}", self.name, rel, line)

    def fetch(self):
        out = run(["git", "ls-remote", "--tags", "--refs", self.url], FETCH_TIMEOUT)[0]
        tags = set(re.findall(r"refs/tags/(v?\d+(?:\.\d+)+)$", out, re.MULTILINE))
        if not tags:
            raise FetchError("版のタグが見つからない")
        github = GITHUB_URL.match(self.url)
        if not github:
            return {"latest": max(tags, key=version_key), "published": None}
        latest, published = settled_tag(*github.groups(), tags)
        return {"latest": latest, "published": published}

    def evaluate(self, data):
        latest = data.get("latest")
        if latest is None or version_key(self.current) >= version_key(latest):
            return None
        summary = f"{self.name} {self.current} → {latest}"
        when = f"（{data['published'][:10]} 公開）" if data.get("published") else "（公開日は確かめていない）"
        return notice(summary + when, summary, [f"{self.where} の {self.name} を {latest} にする"])


class ActionPin(Pin):
    """ワークフローで `uses: owner/repo@<SHA> # vX.Y.Z` と固定した action。"""

    def __init__(self, rel, line, m, occurrence):
        self.owner, self.name, self.sub, self.sha, rest = m.groups()
        version = VERSION_COMMENT.search(rest)
        self.current = version.group(1) if version else None
        label = f"{self.owner}/{self.name}{self.sub}"
        super().__init__(f"action:{rel}:{label}#{occurrence}", label, rel, line)
        if self.current is None:
            self.problem = "SHA で固定しているが、版のコメント（# vX.Y.Z）が無いため確かめられない"

    def fetch(self):
        if self.problem:
            return {}
        out = run(["git", "ls-remote", "--tags", f"https://github.com/{self.owner}/{self.name}.git"], FETCH_TIMEOUT)[0]
        commits = {}
        for line in out.splitlines():
            sha, _, ref = line.partition("\t")
            m = re.fullmatch(r"refs/tags/(v\d+\.\d+\.\d+)(\^\{\})?", ref)
            # 注釈付きタグはタグ自身の SHA と、^{} の付いたコミットの SHA が並ぶ。uses にはコミットを書く。
            if m and (m.group(2) or m.group(1) not in commits):
                commits[m.group(1)] = sha
        if not commits:
            raise FetchError("版のタグが見つからない")
        latest, published = settled_tag(self.owner, self.name, commits)
        return {"latest": latest, "published": published, "sha": commits.get(latest), "tags": commits}

    def evaluate(self, data):
        latest, tags = data.get("latest"), data.get("tags") or {}
        # タグが別のコミットへ付け替えられた（tj-actions/changed-files の乗っ取りと同じ形）か、コメントの
        # 書き間違い。どちらでも付け替え先へ上げてはいけないので、手順は確かめ方だけにする。
        if self.current in tags and tags[self.current] != self.sha:
            commit = f"https://github.com/{self.owner}/{self.name}/commit"
            return notice(
                f"{self.label} のコメントの {self.current} が、固定した SHA とは別のコミットを指している"
                "（タグの付け替えか、コメントの書き間違い）",
                f"{self.label}（タグと SHA が不一致）",
                [f"確かめるまで上げない。固定中: {commit}/{self.sha}", f"いまの {self.current}: {commit}/{tags[self.current]}"],
            )
        if latest is None or self.sha == data.get("sha") or version_key(self.current) >= version_key(latest):
            return None
        summary = f"{self.label} {self.current} → {latest}"
        target = f"{self.where} を {self.label}@{data['sha']} # {latest} にする"
        return notice(f"{summary}（{data['published'][:10]} 公開）", summary, [target])


def find_pins(repo):
    files = []
    for root, dirs, names in os.walk(os.path.join(repo, DEPLOYED_PATH)):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        files += [os.path.join(root, n) for n in names if n.endswith((".yml", ".yaml"))]
    workflows = os.path.join(repo, ".github", "workflows")
    if os.path.isdir(workflows):
        files += [os.path.join(workflows, n) for n in os.listdir(workflows) if n.endswith((".yml", ".yaml"))]

    found = []
    for path in sorted(files):
        rel = os.path.relpath(path, repo)
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.read().splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        seen = {}

        def occurrence(key):
            seen[key] = seen.get(key, 0) + 1
            return seen[key]

        for i, text in enumerate(lines):
            # コメントに残した古い URL などを固定として拾わない。
            code_end = comment_start(text)
            for m in RAW_PIN.finditer(text[:code_end]):
                owner, name, _, file = m.groups()
                found.append(RawPin(rel, i + 1, m, occurrence(f"raw:{owner}/{name}/{file}")))
            uses = USES_SHA.search(text)
            if uses and uses.start() < code_end:
                found.append(ActionPin(rel, i + 1, uses, occurrence(f"action:{uses.group(1)}/{uses.group(2)}{uses.group(3)}")))
            marker = TAG_MARKER.search(text)
            if marker:
                target = KEY_VALUE.match(lines[i + 1]) if i + 1 < len(lines) else None
                found.append(
                    TagPin(rel, i + 2, marker.group(1), target) if target
                    else BrokenPin(rel, i + 1, '目印の次の行から版を読めない（key: "vX.Y.Z" の形で書く）')
                )
    return found


def check_pins(repo, remote=None):
    section = {"label": "固定バージョン", "items": [], "failures": [], "note": None}
    if repo is None:
        section["note"] = "checkout が見つからないため確かめていない"
        return section
    if remote and count(repo, f"HEAD..{remote}", DEPLOYED_PATH, ".github/workflows"):
        # 古いファイルを見て直すよう勧めると、上流で直した変更とぶつかる。
        section["note"] = "checkout が origin より遅れているため、取り込んでから確かめる"
        return section
    cache = read_json(PINS_FILE) or {}
    # キーは checkout からの相対パスなので、別の checkout の結果でも当てはまってしまう。
    entries = (cache.get("pins") or {}) if cache.get("repo") == repo else {}
    section["items"], section["failures"] = evaluate_all(find_pins(repo), entries)
    return section


# ---------------------------------------------------------------- 取得


def long_failure(state):
    """失敗が FETCH_FAILURE_NOTICE_AFTER 以上続いていれば (日数, 理由) を返す。"""
    if not state.get("error"):
        return None
    try:
        elapsed = time.time() - float(state["failing_since"])
    except (TypeError, KeyError, ValueError):
        return None
    if elapsed < FETCH_FAILURE_NOTICE_AFTER:
        return None
    return int(elapsed // (24 * 60 * 60)), state["error"]


def brief(error):
    """シェルを開くたびに出す通知に向けて、取得の失敗の理由を短くする。全文は dotfiles-check で見られる。"""
    if "CERTIFICATE_VERIFY_FAILED" in error:
        return "TLS の証明書を検証できない"
    if "timed out" in error or "タイムアウト" in error:
        return "タイムアウトした"
    if "nodename nor servname" in error or "Name or service not known" in error:
        return "ホスト名を解決できない"
    text = re.sub(r"\s*https?://\S+\s*", " ", error).strip()
    return text if len(text) <= 60 else text[:59] + "…"


def summarize_failures(failures):
    """長く続いている取得の失敗を 1 行にまとめる。"""
    if len(failures) == 1:
        f = failures[0]
        return f"{f['label']} の最新版を {f['days']} 日確かめられていない（{brief(f['error'])}）"
    reasons = {brief(f["error"]) for f in failures}
    reason = reasons.pop() if len(reasons) == 1 else "理由は dotfiles-check で見る"
    return (
        f"{failures[0]['label']} ほか {len(failures) - 1} 件の最新版を "
        f"{min(f['days'] for f in failures)} 日以上確かめられていない（{reason}）"
    )


def attempt(fetch):
    """(結果, 失敗の理由) を返す。"""
    try:
        return fetch(), None
    except FetchError as e:
        return None, str(e)
    except Exception as e:
        return None, f"{type(e).__name__}: {e}"


def next_state(previous, data, error, started):
    previous = previous if isinstance(previous, dict) else {}
    failing_since = previous.get("failing_since") or started
    return {
        # 失敗したときは前回の結果を残す。dotfiles 本体が古い ref で判定を続けるのと揃える。
        "data": data if error is None else previous.get("data"),
        "error": error,
        "failing_since": failing_since if error else None,
    }


def needs_refresh(repo):
    state = read_json(REFRESH_FILE)
    try:
        age = time.time() - float(state["at"])
    except (TypeError, KeyError, ValueError):
        return True
    if state.get("repo") != repo:
        return True
    return age < 0 or age >= (RETRY_INTERVAL if state.get("error") else REFRESH_INTERVAL)


def refresh(wait):
    """リモートを取得し、結果を REFRESH_FILE・TOOLS_FILE・PINS_FILE に残す。dotfiles の取得に失敗したら理由を返す。

    wait が偽なら、別のプロセスが取得中か、取得が要らなくなっていれば何もせずに None を返す。
    wait が真なら、lock を待つ間に別のプロセスが取得を済ませれば、それを使って None を返す。
    """
    os.makedirs(CACHE_DIR, exist_ok=True)
    requested = time.time()
    if not wait and updating():
        # 取得の git fetch や brew outdated が、更新中の pull や brew upgrade とぶつかる。次に開くシェルで取得する。
        return None
    with open(LOCK_FILE, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return None
        repo, _ = locate()
        previous = read_json(REFRESH_FILE) or {}
        same_repo = previous.get("repo") == repo
        if not wait and not needs_refresh(repo):
            return None
        if wait and same_repo and not previous.get("error") and isinstance(previous.get("at"), (int, float)) \
                and previous["at"] >= requested:
            return None
        failing_since = previous.get("failing_since") if same_repo else None
        started = time.time()
        # 取得前に試行を記録する。並んで起動した notify が同じ取得を重ねて始めないため。
        # 途中で落ちたときは失敗扱いになり、RETRY_INTERVAL 後に再試行される。
        write_json(REFRESH_FILE, {
            "repo": repo, "at": started, "error": "取得が完了しなかった", "failing_since": failing_since or started,
        })

        tools = find_tools()
        pins = find_pins(repo) if repo else []
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            dotfiles = pool.submit(attempt, lambda: fetch_dotfiles(repo)) if repo else None
            fetched = {tool.key: pool.submit(attempt, tool.fetch) for tool in tools}
            fetched_pins = {pin.key: pool.submit(attempt, pin.fetch) for pin in pins}
        # checkout が無いのは取得の失敗ではない。失敗として数えると毎時の再試行と「N 日取得できていない」になる。
        error = dotfiles.result()[1] if dotfiles else None

        old = (read_json(TOOLS_FILE) or {}).get("tools") or {}
        write_json(TOOLS_FILE, {
            "at": time.time(),
            "tools": {key: next_state(old.get(key), *future.result(), started) for key, future in fetched.items()},
        })
        old_pins = read_json(PINS_FILE) or {}
        old = (old_pins.get("pins") or {}) if old_pins.get("repo") == repo else {}
        write_json(PINS_FILE, {
            "repo": repo,
            "at": time.time(),
            "pins": {key: next_state(old.get(key), *future.result(), started) for key, future in fetched_pins.items()},
        })
        write_json(REFRESH_FILE, {
            "repo": repo, "at": time.time(), "error": error,
            "failing_since": (failing_since or started) if error else None,
        })
        # 取得で見つかった更新を、次に開くシェルで聞けるようにする。
        sync_pending(update_groups(check_dotfiles(), check_tools()))
        return error


def updating():
    with open(UPDATE_LOCK_FILE, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
    return False


def fetch_failure(repo):
    state = read_json(REFRESH_FILE)
    if not state or state.get("repo") != repo:
        return None
    failure = long_failure(state)
    return f"リモートを {failure[0]} 日確かめられていない（{brief(failure[1])}）" if failure else None


def spawn_refresh():
    # 出力を親から切り離す。継承すると、フックの stdout のパイプや p10k の一時ファイルを
    # 取得が終わるまで握り続ける。
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "refresh"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )


# ---------------------------------------------------------------- 表示


def print_notice(found):
    print(f"  ✗ {found['summary']}")
    for command in found["commands"]:
        print(f"      {command}")


def run_check():
    """結果を表示し、(更新があるか, 判定できなかったものがあるか) を返す。"""
    if sys.stderr.isatty():
        # brew outdated が brew update を走らせると数十秒かかり、その間は何も表示されない。
        print("リモートと各ツールの最新版を取得している…", file=sys.stderr)
    fetch_error = refresh(wait=True)
    dotfiles = check_dotfiles()
    tools = check_tools()
    updates = unknown = False

    print(f"dotfiles ({shown(dotfiles['where']) if dotfiles['where'] else '不明'})")
    if dotfiles["error"]:
        print(f"  ✗ 判定できない: {dotfiles['error']}")
        unknown = True
    else:
        if fetch_error:
            print(f"  ! リモートを取得できなかったため、前回取得した状態で判定した: {fetch_error}")
            unknown = True
        for warning in dotfiles["warnings"]:
            print(f"  ! {warning}")
            unknown = True
        for found in dotfiles["notices"]:
            print_notice(found)
            updates = True
        if not dotfiles["notices"]:
            print("  ? ローカルで分かる範囲では差分が無い" if unknown else "  ✓ 最新")

    pins = check_pins(dotfiles["where"], dotfiles["remote"])
    for section, empty in ((tools, "確かめられるツールが入っていない"), (pins, "固定している版が無い")):
        found_updates, found_unknown = print_items(section, empty)
        updates |= found_updates
        unknown |= found_unknown
    if update_groups(dotfiles, tools):
        print("\ndotfiles 本体とツールは dotfiles-check update でまとめて更新できる")
    return updates, unknown


def print_items(section, empty):
    """節を表示し、(更新があるか, 判定できなかったものがあるか) を返す。"""
    updates = unknown = False
    print(section["label"])
    if section.get("note"):
        print(f"  - {section['note']}")
    elif not section["items"]:
        print(f"  - {empty}")
    for item in section["items"]:
        if item["problem"]:
            print(f"  ! {item['label']}: {item['problem']}")
            unknown = True
        if item["notice"]:
            print_notice(item["notice"])
            updates = True
        elif item["problem"]:
            # 前回の結果は残しているが、確かめていない理由や ✓ まで出すと今回も確かめたように読める。
            continue
        elif item["skipped"]:
            print(f"  - {item['label']}: {item['skipped']}")
        else:
            print(f"  ✓ {item['label']}")
    return updates, unknown


# p10k の見た目に揃える。.p10k.zsh の POWERLEVEL9K_BACKGROUND（236）と区切り（ / ）、
# .zshrc の SPROMPT や補完のメッセージで使っている色とアイコンと同じものを使う。
PL_BG = "\033[48;5;236m"
PL_END = "\033[0m\033[38;5;236m\ue0b0\033[0m"
PL_SEP = " \033[38;5;244m\ue0b1\033[38;5;007m "
PL_DEFAULT = "\033[38;5;007m"
PL_COLORS = {
    "warn": "\033[38;5;003m", "error": "\033[38;5;001m", "update": "\033[38;5;014m", "info": "\033[38;5;245m",
    "ok": "\033[38;5;002m", "progress": "\033[38;5;014m",
}
PL_ICONS = {
    "dotfiles": "\ue0a0", "tools": "\uf0ad", "pins": "\uf08d", "warn": "\uf071", "info": "\uf05a",
    "ok": "\uf00c", "question": "\uf059",
}
NOTIFY_FOOTER = "詳細と更新手順は dotfiles-check で表示する"
UPDATE_FOOTER = "詳細は dotfiles-check、更新は dotfiles-check update で行う"


def notify_rows(repo, dotfiles, tools):
    """通知に出す行を (アイコン, 色, 見出し, 項目) の並びで返す。"""
    label = dotfiles["label"]
    rows = [("warn", "error", label, [dotfiles["error"]])] if dotfiles["error"] else []
    rows += [("dotfiles", "warn", label, [n["summary"]]) for n in dotfiles["notices"]]
    rows += [("warn", "warn", label, [w]) for w in dotfiles["warnings"]]
    failure = fetch_failure(repo)
    if failure:
        rows.append(("warn", "error", label, [failure]))
    for icon, section in (("tools", tools), ("pins", check_pins(repo, dotfiles["remote"]))):
        shorts = [item["notice"]["short"] for item in section["items"] if item["notice"]]
        if shorts:
            # シェルを開くたびに出るので、節ごとに 1 行にまとめる。
            rows.append((icon, "update", f"{section['label']}の更新", shorts))
        if section["failures"]:
            rows.append(("warn", "error", section["label"], [summarize_failures(section["failures"])]))
    return rows


def render_plain(rows, footer=None):
    lines = []
    for _, color, title, items in rows + ([("info", "info", footer, [])] if footer else []):
        if color == "info":
            lines.append(f"  {title}")
            continue
        mark = {"ok": "✓", "progress": "▶"}.get(color, "⚠")
        lines.append(f"{mark} {title}: {'、'.join(items)}" if items else f"{mark} {title}")
    return "\n".join(lines)


def render_powerline(rows, footer=None):
    """Nerd Font（fonts ロールが入れる MesloLGS NF）の記号と 256 色で描く。"""
    lines = []
    for icon, color, title, items in rows + ([("info", "info", footer, [])] if footer else []):
        if color == "info":
            lines.append(f"{PL_BG}{PL_COLORS['info']} {PL_ICONS[icon]} {title} {PL_END}")
            continue
        body = "".join(PL_SEP + item.replace(" → ", " \uf061 ") for item in items)
        lines.append(f"{PL_BG}{PL_COLORS[color]} {PL_ICONS[icon]} {PL_DEFAULT}{title}{body} {PL_END}")
    return "\n".join(lines)


def render(rows, style, footer=None):
    return render_powerline(rows, footer) if style == "powerline" else render_plain(rows, footer)


def run_notify(fmt, style="plain"):
    try:
        repo, _ = locate()
        if needs_refresh(repo):
            spawn_refresh()
        dotfiles, tools = check_dotfiles(), check_tools()
        rows = notify_rows(repo, dotfiles, tools)
        groups = update_groups(dotfiles, tools)
        sync_pending(groups)
    except Exception as e:
        # 黙ると利用者は dotfiles-check を実行する理由が無く、壊れたまま気づけない。
        rows, groups = [("warn", "error", "dotfiles-check", [f"notify が失敗した（{type(e).__name__}）"])], []
    if not rows:
        return 0
    footer = UPDATE_FOOTER if groups else NOTIFY_FOOTER
    if fmt == "claude":
        # stdout の素のテキストは Claude のコンテキストに入る。systemMessage は利用者にだけ見える。
        # Claude Code の画面は色を出さず、フォントに Nerd Font の記号があるとも限らないので文字だけで書く。
        print(json.dumps({"systemMessage": render_plain(rows, footer)}, ensure_ascii=False))
    else:
        print(render(rows, style, footer))
    return 0


def run_pins(repo, fmt):
    """終了コードは手動実行と同じ。固定が 1 つも見つからなければ 2 を返す。"""
    pins = find_pins(repo)
    # 走査が壊れて 0 件になったのを「すべて最新」と取り違えると、issue が閉じたまま気づけない。
    if not pins:
        print(f"{repo} に固定している版が見つからない", file=sys.stderr)
        return 2
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        fetched = {pin.key: pool.submit(attempt, pin.fetch) for pin in pins}
    entries = {key: next_state(None, *future.result(), time.time()) for key, future in fetched.items()}
    items, _ = evaluate_all(pins, entries)
    updates = any(item["notice"] for item in items)
    unknown = any(item["problem"] for item in items)
    if fmt == "markdown":
        # 取得の失敗の理由は毎回変わりうるので本文には書かず、実行ログに残す。
        for item in items:
            if item["problem"]:
                print(f"{item['label']}: {item['problem']}", file=sys.stderr)
        print_pins_markdown(items)
    else:
        print_items({"label": "固定バージョン", "items": items}, "固定している版が無い")
    return 1 if updates else 2 if unknown else 0


def md(text):
    """issue の表に入れても崩れず、上流から来た文字列が HTML やメンションとして解釈されない形にする。"""
    return (
        text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("|", "\\|").replace("@", "&#64;")
    )


def fence(text):
    """text の中のどのバッククォートの並びより長いコードブロックの区切り。"""
    longest = max((len(run) for run in re.findall(r"`+", text)), default=0)
    return "`" * max(3, longest + 1)


# issue の本文の上限は 65,536 文字。本文は環境変数でジョブ間を渡すので、1 つの値の上限（Linux で 128 KiB）にも収める。
MARKDOWN_MAX_CHARS = 60_000
MARKDOWN_MAX_BYTES = 120_000


def print_pins_markdown(items):
    parts = ["dotfiles-check が固定している版を確かめた結果。直したら、次の定期実行でこの issue は閉じる。\n"]
    found = [item for item in items if item["notice"]]
    if found:
        rows = ["| 対象 | 状態 | 直し方 |", "| --- | --- | --- |"]
        for item in found:
            steps = "<br>".join(md(command) for command in item["notice"]["commands"])
            rows.append(f"| {md(item['label'])} | {md(item['notice']['summary'])} | {steps} |")
        parts.append("\n".join(rows))
    problems = [item for item in items if item["problem"]]
    if problems:
        lines = ["\n確かめられなかったもの:\n"]
        for item in problems:
            problem = item["problem"]
            if problem.startswith("最新版を取得できなかった"):
                problem = "最新版を取得できなかった（理由は実行ログにある）"
            lines.append(f"- {md(item['label'])}: {md(problem)}")
        parts.append("\n".join(lines))
    current = [md(item["label"]) for item in items if not item["notice"] and not item["problem"]]
    if current:
        parts.append(f"\n最新のもの: {'、'.join(current)}")

    text = "\n".join(parts)
    for item in found:
        details = item["notice"].get("details")
        if not details:
            continue
        mark = fence(details)
        block = f"\n\n<details><summary>{md(item['label'])} の差分</summary>\n\n{mark}diff\n{details}\n{mark}\n\n</details>"
        omitted = f"\n\n{md(item['label'])} の差分は長いため省いた。直し方の行のリンクから確かめる。"
        text += block if fits(text + block) else omitted
    print(text)


def fits(text):
    return len(text) <= MARKDOWN_MAX_CHARS and len(text.encode("utf-8")) <= MARKDOWN_MAX_BYTES


# ---------------------------------------------------------------- 更新
#
# 更新できるものを 3 つに分けて聞き、選ばれたものの手順を実行する。固定バージョンは
# リポジトリを直す必要があるので含めない。


UPDATE_GROUPS = [("dotfiles", "d", "dotfiles", "dotfiles"), ("tools", "t", "ツール", "tools"), ("brew", "b", "Homebrew", "tools")]


def update_groups(dotfiles, tools):
    """更新できるものを、実行する順にグループの dict で返す。"""
    found = [n for n in dotfiles["notices"] if n["steps"]], [], []
    for item in tools["items"]:
        if item["notice"] and item["notice"]["steps"]:
            found[2 if item["key"] == "brew" else 1].append(item["notice"])
    return [
        {"id": gid, "letter": letter, "title": title, "icon": icon, "notices": notices, "keys": [k for n in notices for k in n["keys"]]}
        for (gid, letter, title, icon), notices in zip(UPDATE_GROUPS, found) if notices
    ]


def ask_policy():
    """changed（断った内容が変わるまで聞かない）、always（毎回聞く）、never（聞かない）。"""
    value = os.environ.get("DOTFILES_UPDATE_ASK", "")
    return value if value in ("always", "never") else "changed"


def askable(groups, declined):
    policy = ask_policy()
    if policy == "never":
        return []
    return [g for g in groups if policy == "always" or not set(g["keys"]) <= declined]


def read_declined():
    keys = (read_json(UPDATE_DECLINED_FILE) or {}).get("keys")
    return {k for k in keys if isinstance(k, str)} if isinstance(keys, list) else set()


def sync_pending(groups, declined=None):
    """断った記録を今の内容に合わせ、聞くことがあるかを UPDATE_PENDING_FILE に残す。"""
    declined = read_declined() if declined is None else declined
    # 今は無いものの記録は捨てる。手で上げた項目の記録が残り続けないようにする。
    kept = declined & {k for g in groups for k in g["keys"]}
    if kept != declined:
        write_json(UPDATE_DECLINED_FILE, {"keys": sorted(kept)})
    content = " ".join(g["id"] for g in askable(groups, kept))
    try:
        with open(UPDATE_PENDING_FILE, encoding="utf-8") as f:
            current = f.read()
    except OSError:
        current = None
    # シェルを開くたびに呼ばれるので、変わったときだけ書く。
    if current != content and (current is not None or content):
        write_text(UPDATE_PENDING_FILE, content)


def record_declined(groups):
    keys = read_declined() | {k for g in groups for k in g["keys"]}
    write_json(UPDATE_DECLINED_FILE, {"keys": sorted(keys)})


def typed_ahead():
    """改行まで打たれた入力が読まれずに残っているか。端末は行単位で渡すので、打ちかけの行は数えない。"""
    import select

    return bool(select.select([sys.stdin], [], [], 0)[0])


def ask(groups, style, startup):
    """選ばれたグループを返す。n なら []、Enter や Ctrl-C など答えを得られなければ None。"""
    import termios

    choices = [(g["letter"], g["title"]) for g in groups]
    if len(groups) > 1:
        choices.append(("a", "すべて"))
    choices += [("n", "しない"), ("Enter", "あとで")]
    if style == "powerline":
        body = "".join(f"{PL_SEP}{PL_COLORS['update']}{letter}{PL_DEFAULT} {title}" for letter, title in choices)
        prompt = f"{PL_BG}{PL_COLORS['update']} {PL_ICONS['question']} {PL_DEFAULT}更新する？{body} {PL_END} "
    else:
        prompt = "? 更新する？ " + "、".join(f"{letter} = {title}" for letter, title in choices) + ": "
    letters = "".join(g["letter"] for g in groups)
    # 止めたまま放置されると update.lock を握り続け、ほかのシェルが黙って聞かなくなる。
    previous = signal.signal(signal.SIGTSTP, signal.SIG_IGN)
    try:
        for _ in range(3):
            # 質問が出る前に打たれたキー（開いてすぐの Enter や、端末が起動時に送るコマンド）を答えにしない。
            termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
            try:
                answer = re.sub(r"[\s,]", "", input(prompt).lower())
            except (EOFError, KeyboardInterrupt):
                print()
                return None
            if answer == "":
                return None
            if answer == "n":
                return []
            if answer == "a":
                return groups
            if set(answer) <= set(letters):
                return [g for g in groups if g["letter"] in answer]
            decline = "内容が変わるまで聞かない" if startup else "更新しない"
            print(f"{'・'.join(letters)} を並べて選ぶ（例: {letters}）。a はすべて、n は{decline}、Enter はあとで")
        return None
    finally:
        signal.signal(signal.SIGTSTP, previous)


# 更新中は子の出力の末尾をこの行数だけ見せる。失敗したら、原因を追えるよう長めに残す。
LIVE_LINES = 5
FAILURE_LINES = 30
# 改行の無い出力が延々と続いても、溜める量をこれで抑える。
PARTIAL_MAX = 4096
# 出力を消しても後から読めるよう、最後の update の全文をここに残す。
UPDATE_LOG_FILE = os.path.join(CACHE_DIR, "update.log")
ESCAPE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[()][0-9A-Za-z]|\x1b[=>78]")
# パスワードのプロンプトを /dev/tty に直接書くので窓にしない。
UNWINDOWED = {"sudo"}


def printable(text):
    """エスケープ列と制御文字を落とす。"""
    import unicodedata

    return "".join(c for c in ESCAPE.sub("", text).expandtabs(4) if unicodedata.category(c) not in ("Cc", "Cf"))


def clip(text, width):
    """端末の幅に収まるよう切る。全角は 2 桁と数える。"""
    import unicodedata

    out, used = [], 0
    for c in text:
        w = 0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
        if used + w > width:
            return "".join(out[:-1]) + "…" if out else ""
        out.append(c)
        used += w
    return "".join(out)


def terminal_mode():
    """(行編集, エコー, 出力の改行の変換) が有効か。端末でなければ None。"""
    import termios

    try:
        attrs = termios.tcgetattr(sys.stdin.fileno())
    except (termios.error, OSError, ValueError):
        return None
    return bool(attrs[3] & termios.ICANON), bool(attrs[3] & termios.ECHO), bool(attrs[1] & termios.OPOST)


def awaiting_input(mode):
    """子が端末の設定を変えた後の mode が、入力を待つときの形か。

    ansible の pause は tty.setraw で出力の変換まで外し、sudo や getpass は行編集を残してエコーだけを切る。
    Homebrew はサンドボックスの子を擬似端末で流す間、出力の変換を残したまま raw にする（入力の素通しで、
    出力は Homebrew の stdout から来る）ので、これは入力待ちとみなさない。
    """
    line_editing, echo, output_processing = mode
    return not output_processing or (line_editing and not echo)


class Live:
    """子の出力の末尾を数行だけ描き直す。終わったら erase で消す。

    子が端末を使い始めたら（raw にする、エコーを切る、利用者が何か打つ）描き直しをやめて凍結し、
    以降は子の出力をそのまま流す。凍結した窓や窓より下に何かが出たら dirty にする。dirty なら、
    見出しの行を結果で置き換えられない。
    """

    def __init__(self, log=None):
        import collections

        self.tail = collections.deque(maxlen=FAILURE_LINES)
        self.partial = ""
        # 受け取った行の数と、そのうち画面に出した行の数。凍結するとき、間引いて出していない行を書き足す。
        self.fed = self.shown = 0
        self.drawn = 0
        self.last_draw = 0.0
        self.stale = False
        self.dirty = False
        self.frozen = False
        self.line_open = False
        self.mode = None
        self.log = log
        # 行数の少ない端末では、窓が画面からはみ出して戻れなくなる。
        self.height = max(1, min(LIVE_LINES, (shutil.get_terminal_size().lines or 24) - 2))

    def feed(self, text):
        # つないでから行に分けて除く。chunk の境目で切れたエスケープ列が残らないようにする。
        lines = (self.partial + text).split("\n")
        for line in lines[:-1]:
            # 進み具合の表示は \r で同じ行を書き直す。最後に書かれたものだけを残す。
            self.tail.append(printable(line.rstrip("\r").rsplit("\r", 1)[-1]))
            self.fed += 1
        self.partial = lines[-1][-PARTIAL_MAX:]

    def write(self, text):
        sys.stdout.write(text)
        sys.stdout.flush()

    def interrupted(self):
        """描き直すと表示を壊す状態なら凍結して真を返す。子が端末の設定を変えたか、利用者が何か打ったとき。"""
        now = terminal_mode() if self.mode is not None else None
        if now is not None and now != self.mode and awaiting_input(now):
            # 孫が /dev/tty に直接書いたプロンプト（sudo の Password: など）の後ろに続けて書かない。
            self.freeze(newline=True)
        elif typed_ahead():
            self.freeze()
        return self.frozen

    def draw(self, force=False):
        if self.frozen or self.interrupted():
            return
        now = time.monotonic()
        # brew などは大量に出すので、描き直しを間引いてちらつきを抑える。間引いた分は run が後で描く。
        if not force and now - self.last_draw < 0.05:
            self.stale = True
            return
        self.last_draw, self.stale = now, False
        width = max((shutil.get_terminal_size().columns or 80) - 3, 10)
        # 改行の無い行は描かない。入力待ちのプロンプトなら、打った文字が窓の下に出て戻る位置がずれる。
        shown = list(self.tail)[-self.height:]
        # 幅の数え違いがあっても折り返さないよう、描く間は自動の折り返しを止める。戻るのは描いた行数だけでよい。
        lines = "".join(f"\033[2m  {clip(line, width)}\033[0m\r\n" for line in shown)
        self.write(self.erase_sequence() + "\033[?7l" + lines + "\033[?7h")
        self.drawn, self.shown = len(shown), self.fed

    def erase_sequence(self):
        sequence = f"\r\033[{self.drawn}A\033[J" if self.drawn else ""
        self.drawn = 0
        return sequence

    def erase(self):
        self.write(self.erase_sequence())

    def freeze(self, newline=False):
        """描き直しをやめる。窓は消さない（子や孫が端末に直接書いたプロンプトを消さないため）。

        間引いてまだ出していない行（プロンプトの直前の行やプロンプトそのもの）は、窓の下に書き足す。
        子が端末を raw にしていても崩れないよう、行は \r\n で終える。
        """
        unseen = list(self.tail)[-(self.fed - self.shown):] if self.fed > self.shown else []
        self.write(("\r\n" if newline else "") + "".join(f"\033[2m  {line}\033[0m\r\n" for line in unseen) + self.partial)
        # 書き足した最後の行が改行で終わっていなければ、続く結果の行の前に改行が要る。
        self.line_open = bool(self.partial)
        self.frozen, self.dirty, self.drawn, self.shown, self.partial = True, True, 0, self.fed, ""

    def keep(self):
        """消さずに末尾を残す。失敗や中断のときに原因を見せるため。"""
        if self.frozen:
            # 子の出力はそのまま画面に出ている。
            return
        self.erase()
        lines = list(self.tail) + ([printable(self.partial)] if self.partial else [])
        self.write("".join(f"\033[2m  {line}\033[0m\r\n" for line in lines[-FAILURE_LINES:]))
        self.dirty = True

    def run(self, argv, env):
        import codecs
        import select

        self.frozen, self.line_open, self.mode = False, False, terminal_mode()
        # Python の子は、stdout がパイプだとプロンプトを溜めたまま入力を待つ（ansible の pause など）。
        # git の認証のプロンプトはエコーを切らず入力待ちと見分けられないので、聞かずに失敗させる（失敗なら末尾が残る）。
        env = {**env, "PYTHONUNBUFFERED": "1", "GIT_TERMINAL_PROMPT": "0"}
        p = subprocess.Popen(argv, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        fd = p.stdout.fileno()
        decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
        while True:
            ready, _, _ = select.select([fd], [], [], 0.1)
            if ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                if self.log:
                    # 途中で止められても、そこまでの出力が残るようにする。
                    self.log.write(chunk)
                    self.log.flush()
                if self.frozen:
                    sys.stdout.buffer.write(chunk)
                    sys.stdout.buffer.flush()
                    self.line_open = not chunk.endswith(b"\n")
                    continue
                self.feed(decoder.decode(chunk))
                self.draw()
                continue
            if not self.frozen and not self.interrupted():
                if printable(self.partial).strip():
                    # 改行の無いまま止まった（シェルの read などのプロンプト）。色を戻すエスケープ列だけが
                    # 改行の後ろに残ることがある（zinit など）ので、見える文字があるときだけにする。
                    self.freeze()
                elif self.stale:
                    # 出力が止まったときに最後の行が描かれないままにならないようにする。
                    self.draw(force=True)
            if p.poll() is not None:
                # 子が残したバックグラウンドのプロセスがパイプを握っていると EOF が来ない。
                break
        p.stdout.close()
        code = p.wait()
        if self.line_open:
            # 続けて出す結果の行が、子の最後の行に続かないようにする。
            self.write("\r\n")
        if not self.frozen:
            self.draw(force=True)
        return code


def run_steps(steps, live=None, log=None):
    """手順を順に実行する。失敗したら残りを飛ばし、その説明を返す。Ctrl-C なら子が終わってから KeyboardInterrupt を投げる。

    live を渡すと、子の出力を末尾の数行だけ描く。渡さなければ端末にそのまま流す。log には全文を書く。
    """
    # 色や認証のプロンプトは利用者に見せるので CHILD_ENV は使わない。
    env = {**os.environ, "DOTFILES_UPDATING": "1"}
    for display, argv in steps:
        windowed = live is not None and os.path.basename(argv[0]) not in UNWINDOWED
        if log:
            log.write(f"$ {display}{'' if windowed or live is None else '（端末にそのまま出した）'}\n".encode())
            log.flush()
        if windowed:
            live.feed(f"$ {display}\n")
            live.draw(force=True)
        else:
            if live is not None:
                live.erase()
                live.dirty = True
            print(f"$ {display}", flush=True)
        interrupted = []
        # Ctrl-C の後始末は子に任せる。既定のままだと subprocess が 0.25 秒で子を SIGKILL する。
        # SIG_IGN は exec 後も引き継がれて子が止まれなくなるので、何もしないハンドラにする（exec で既定に戻る）。
        previous = signal.signal(signal.SIGINT, lambda *_: interrupted.append(True))
        try:
            code = live.run(argv, env) if windowed else subprocess.Popen(argv, env=env).wait()
        except OSError as e:
            return f"{display} を起動できない（{e}）"
        finally:
            signal.signal(signal.SIGINT, previous)
        if interrupted:
            raise KeyboardInterrupt
        if code != 0:
            if windowed:
                live.keep()
            return f"{display} が {code} で終了した"
    return None


def run_update(startup, only, style):
    """startup なら、聞いたときに 0、聞くことが無ければ何も出さずに 1 を返す。

    それ以外は 0 = 更新した（更新が無いときも）、1 = 失敗したものがある、2 = 対象を選べなかった。
    """
    os.makedirs(CACHE_DIR, exist_ok=True)
    repo, asked = None, False
    try:
        with open(UPDATE_LOCK_FILE, "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                # 同時に開いたシェルでそれぞれ聞くと、同じ更新が並んで走る。
                if startup:
                    return 1
                print("別のシェルで更新を確認しているか、更新している", file=sys.stderr)
                return 2
            repo, _ = locate()
            fetch_error = None
            if not startup:
                if sys.stderr.isatty():
                    print("リモートと各ツールの最新版を取得している…", file=sys.stderr)
                fetch_error = refresh(wait=True)
            dotfiles, tools = check_dotfiles(), check_tools()
            groups = update_groups(dotfiles, tools)
            if startup and not askable(groups, read_declined()):
                sync_pending(groups)
                return 1
            if startup and typed_ahead():
                # 開いてすぐ打ったコマンドは、捨てずにシェルに渡す。次のシェルでまた聞く。
                return 1
            asked = True
            return update_chosen(repo, dotfiles, tools, groups, startup, only, style, fetch_error)
    finally:
        # 聞いたシェルでは notify を出さないので、取得の起動もここで行う。更新と lock の後に回すのは、
        # 取得の git fetch や brew outdated を、選んだ pull や brew upgrade と同時に走らせないため。
        if startup and asked and needs_refresh(repo):
            spawn_refresh()


def update_chosen(repo, dotfiles, tools, groups, startup, only, style, fetch_error):
    rows = notify_rows(repo, dotfiles, tools)
    if fetch_error:
        rows.insert(0, ("warn", "error", dotfiles["label"], [f"リモートを取得できなかったため、前回取得した状態で判定した（{fetch_error}）"]))
    if rows:
        print(render(rows, style))
    if not groups:
        print("dotfiles-check update で更新できるものは無い")
        return 0
    if only is not None:
        chosen = [g for g in groups if "all" in only or g["id"] in only]
        if not chosen:
            print("指定した対象に更新は無い")
            return 0
    elif not sys.stdin.isatty():
        print("端末から実行するか、--only で対象を選ぶ", file=sys.stderr)
        return 2
    else:
        chosen = ask(groups, style, startup)
    if chosen is None:
        if startup:
            print(render([("info", "info", "次のシェルでまた聞く", [])], style))
        return 0 if startup else 2
    if startup:
        # 選ばなかったものも断ったものとして扱う。毎回聞くと、上げないと決めたものを聞き続ける。
        record_declined([g for g in groups if g not in chosen])
    if not chosen:
        sync_pending(groups)
        if startup:
            message = "次のシェルでまた聞く" if ask_policy() == "always" else "内容が変わるまで聞かない"
            print(render([("info", "info", f"{message}。dotfiles-check update でいつでも更新できる", [])], style))
        return 0

    results, updated, started, done = [], set(), 0, 0
    # 端末でなければ（ログに落とすときなど）、出力を消さずにそのまま流す。カーソルを動かせない端末も同じ。
    live_output, live = sys.stdout.isatty() and os.environ.get("TERM", "dumb") != "dumb", None

    def show(row):
        results.append(row)
        print(render([row], style), flush=True)

    # 取得と同時に走らせない。取得の git fetch が ref を握っていると、pull は "cannot lock ref" で失敗する。
    # 質問の間は握らない。握ると、答えを待つシェルがある限り手動の dotfiles-check が待ち続ける。
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(LOCK_FILE, "w") as fetching, open(UPDATE_LOG_FILE, "wb") as log:
        try:
            try:
                fcntl.flock(fetching, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                print("バックグラウンドの取得が終わるのを待っている…", flush=True)
                fcntl.flock(fetching, fcntl.LOCK_EX)
            for group in chosen:
                show((group["icon"], "progress", group["title"], ["更新する"]))
                log.write(f"== {group['title']}\n".encode())
                started += 1
                live = Live(log) if live_output else None
                # ツールは 1 つ失敗しても残りを上げる。
                errors = [e for e in (run_steps(n["steps"], live, log) for n in group["notices"]) if e]
                if errors:
                    row = ("warn", "error", group["title"], errors)
                elif group["id"] in {g["id"] for g in update_groups(check_dotfiles(), check_tools())}:
                    # 手順が 0 で終わっても、判定が変わらなければ上がっていない。
                    row = ("warn", "warn", group["title"], ["手順は終わったが、まだ更新が残っている"])
                else:
                    updated.add(group["id"])
                    row = ("ok", "ok", group["title"], ["更新した"])
                if live is not None:
                    live.erase()
                    if not live.dirty:
                        # 出力を消したので、見出しの行を結果で置き換える。
                        sys.stdout.write("\r\033[1A\033[2K")
                show(row)
                done += 1
        except KeyboardInterrupt:
            if live is not None:
                # 子が後始末で出したものを消さない。
                live.keep()
            print()
            for i, group in enumerate(chosen[done:]):
                show(("warn", "error", group["title"], ["中断した" if done + i < started else "中断したため実行していない"]))
        sync_pending(update_groups(check_dotfiles(), check_tools()))
    hints = []
    if "dotfiles" in updated:
        hints.append(("info", "info", "このシェルは更新前の設定のまま。exec zsh で読み込み直す", []))
    if startup and len(chosen) < len(groups) and ask_policy() == "changed":
        hints.append(("info", "info", "選ばなかったものは内容が変わるまで聞かない", []))
    failed = any(color not in ("ok", "progress") for _, color, _, _ in results)
    if live_output and failed:
        # 窓から消えた出力を、失敗や中断の原因を追うときに読めるようにする。
        hints.append(("info", "info", f"出力の全文は {shown(UPDATE_LOG_FILE)} にある", []))
    if hints:
        print(render(hints, style))
    return 0 if startup else 1 if failed else 0


def parse_only(value):
    targets = {t.strip() for t in value.split(",") if t.strip()}
    unknown = targets - {"dotfiles", "tools", "brew", "all"}
    if not targets or unknown:
        raise argparse.ArgumentTypeError("dotfiles・tools・brew・all をカンマで並べる")
    return targets


def main():
    parser = argparse.ArgumentParser(
        prog="dotfiles-check",
        description=(
            "dotfiles と、それが入れたツール・固定している版の更新を確かめる。引数なしで実行すると、リモートを取得して"
            "結果と更新手順を表示する。終了コードは 0 = 更新なし、1 = 更新あり、2 = 判定できないものがあった。"
            "更新ありと判定できないものが両方あれば 1 を返す。standalone 以外の uv など、確かめなかったものは数えない。"
        ),
    )
    sub = parser.add_subparsers(dest="command")
    notify = sub.add_parser(
        "notify",
        help="前回取得した状態から通知を出す。取得から時間が経っていればバックグラウンドで取得し直す",
    )
    notify.add_argument(
        "--format",
        choices=["text", "claude"],
        default="text",
        help="claude は Claude Code の SessionStart フック向けの JSON を出す",
    )
    notify.add_argument(
        "--style",
        choices=["plain", "powerline"],
        default="plain",
        help="powerline は Nerd Font の記号と 256 色で描く（--format text のときだけ効く）",
    )
    update = sub.add_parser(
        "update",
        help=(
            "リモートを取得して更新できるもの（dotfiles 本体・ツール・Homebrew）を表示し、選んだものを更新する。"
            "終了コードは 0 = 更新した（更新が無いときも）、1 = 失敗したものがある、2 = 対象を選べなかった"
        ),
    )
    update.add_argument("--only", type=parse_only, help="聞かずに更新する対象。dotfiles・tools・brew・all をカンマで並べる")
    update.add_argument(
        "--startup",
        action="store_true",
        help=(
            ".zshrc がシェルの起動時に呼ぶ。取得せず、聞いたら 0、聞くことが無ければ何も出さずに 1 を返す。"
            "n で断った内容は変わるまで聞かない。~/.zshenv.local などで export DOTFILES_UPDATE_ASK=always にすると毎回、never にすると聞かない"
        ),
    )
    update.add_argument("--style", choices=["plain", "powerline"], default="plain", help="powerline は Nerd Font の記号と 256 色で描く")
    sub.add_parser("refresh", help="リモートを取得する。notify がバックグラウンドで起動する")
    pins = sub.add_parser("pins", help="キャッシュを使わずに固定バージョンだけを確かめる。GitHub Actions から呼ぶ")
    pins.add_argument("--repo", default=".", help="走査するリポジトリ")
    pins.add_argument("--format", choices=["text", "markdown"], default="text")
    args = parser.parse_args()

    if args.command == "notify":
        return run_notify(args.format, args.style)
    if args.command == "refresh":
        refresh(wait=False)
        return 0
    if args.command == "update":
        try:
            return run_update(args.startup, args.only, args.style)
        except KeyboardInterrupt:
            # 質問の前に止められたときは何も出ていないので、notify にいつもの通知を出させる。
            print()
            return 1 if args.startup else 2
        except Exception as e:
            if args.startup:
                # シェルを開くたびにトレースバックを出さない。1 を返して、続く notify にいつもの通知を出させる。
                print(f"dotfiles-check update が失敗した（{type(e).__name__}: {e}）")
                return 1
            traceback.print_exc()
            return 2
    if args.command == "pins":
        try:
            return run_pins(os.path.abspath(args.repo), args.format)
        except Exception:
            # 1 は「更新あり」なので、想定外の失敗で issue を作らないよう区別する。
            traceback.print_exc()
            return 2
    try:
        updates, unknown = run_check()
    except Exception:
        # 1 は「更新あり」の意味なので、想定外の失敗をそれと区別する。
        traceback.print_exc()
        return 2
    return 1 if updates else 2 if unknown else 0


if __name__ == "__main__":
    sys.exit(main())
