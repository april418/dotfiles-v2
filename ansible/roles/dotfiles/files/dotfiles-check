class FetchError(Exception):
    pass


def git(repo, *args):
    """成功したら stdout を返す。失敗したら None。"""
    try:
        p = subprocess.run(
            ["git", "-C", repo, *args],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=10,
            env=CHILD_ENV,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout.strip() if p.returncode == 0 else None


def run(args, timeout):
    """(stdout, stderr) を返す。起動できない・時間切れ・0 以外で終了したら FetchError を投げる。"""
    try:
        # 子の子まで止められるよう、別のプロセスグループで起動する。brew は brew update を子として走らせ、
        # 直接の子だけを kill すると update のロックを握ったまま残る。
        p = subprocess.Popen(
            args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, env=CHILD_ENV, start_new_session=True,
        )
    except OSError as e:
        raise FetchError(str(e))
    try:
        stdout, stderr = p.communicate(timeout=timeout)
    except BaseException as e:
        os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        if isinstance(e, subprocess.TimeoutExpired):
            raise FetchError(f"{timeout} 秒でタイムアウトした")
        raise
    if p.returncode != 0:
        lines = [line.strip() for line in stderr.splitlines() if line.strip()]
        # 最終行は複数行のメッセージの続き（"and the repository exists." など）になりがち。
        # brew は "Error:" と大文字で始める。
        reason = next((line for line in lines if re.match(r"(fatal|error):", line, re.IGNORECASE)), lines[0] if lines else None)
        raise FetchError(reason or f"{os.path.basename(args[0])} が {p.returncode} で終了した")
    return stdout, stderr


# 既定で使える証明書を持たない Python（python.org の配布物は Install Certificates を流すまで持たない）のときに使う。
# macOS の Homebrew の束は、キーチェーンで信頼された証明書も取り込んで作られる。
CA_BUNDLES = [
    "/opt/homebrew/etc/ca-certificates/cert.pem",
    "/usr/local/etc/ca-certificates/cert.pem",
    "/etc/ssl/cert.pem",
    "/etc/ssl/certs/ca-certificates.crt",
    "/etc/pki/tls/certs/ca-bundle.crt",
    "/etc/ssl/ca-bundle.pem",
]
_ssl_context = []


def ssl_context():
    """既定の証明書が使えれば None（urlopen の既定に任せる）、使えなければ CA_BUNDLES で検証する context。"""
    if not _ssl_context:
        import ssl

        paths = ssl.get_default_verify_paths()
        usable = (paths.cafile and os.path.isfile(paths.cafile)) or (
            paths.capath and os.path.isdir(paths.capath) and os.listdir(paths.capath)
        )
        bundle = None if usable else next((b for b in CA_BUNDLES if os.path.isfile(b)), None)
        _ssl_context.append(ssl.create_default_context(cafile=bundle) if bundle else None)
    return _ssl_context[0]


def http_get(url, token=None):
    """(HTTP の状態コード, 本文) を返す。通信できなければ FetchError を投げる。"""
    # notify は通信しないので、遅い ssl などの import を取得のときまで遅らせる。
    import urllib.error
    import urllib.request

    request = urllib.request.Request(url, headers={"User-Agent": "dotfiles-check"})
    if token:
        # 通常のヘッダーはリダイレクト先が別のホストでも引き継がれる。トークンは最初の宛先にだけ送る。
        request.add_unredirected_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(request, timeout=FETCH_TIMEOUT, context=ssl_context()) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, b""
    except OSError as e:
        raise FetchError(f"{url} に接続できない（{e}）")


def quote_path(path):
    from urllib.parse import quote

    return quote(path)


