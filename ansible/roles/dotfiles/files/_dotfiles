#compdef dotfiles
# files/dotfiles の main() の argparse と同じサブコマンドとオプションを並べる。

# dotfiles コマンドの locate() と同じ checkout を REPLY に入れる。見つからなければ空にして 1 を返す。
_dotfiles_checkout() {
  local applied=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/applied.json repo top
  local -a candidates
  REPLY=
  # record.yml の to_nice_json は ASCII 以外を \uXXXX で書くので、(g:e:) で戻す。
  [[ -r $applied && $(<$applied) =~ '"repo": *"([^"]*)"' ]] && candidates+=("${(g:e:)match[1]}")
  [[ -n $DOTPATH ]] && candidates+=("$DOTPATH")
  candidates+=("$HOME/.dotfiles")
  for repo in $candidates; do
    [[ -d $repo ]] && top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || continue
    REPLY=$top
    return 0
  done
  return 1
}

_dotfiles_characters() {
  setopt localoptions extendedglob
  local expl REPLY
  local -a names
  if _dotfiles_checkout; then
    names=($REPLY/ansible/roles/claude/files/characters/*.md(N:t:r))
    # dotfiles コマンドの CHARACTER_NAME と同じく、記録から読める文字種の名前に限る。
    names=(${(M)names:#[a-z0-9-]##})
  fi
  _wanted characters expl character compadd -a names
}

_dotfiles_pins() {
  local expl REPLY
  local -a names
  # dotfiles コマンドの find_pins() と同じく、`# dotfiles: tags` の目印の次の行の変数名を拾う。
  _dotfiles_checkout && names=(${(f)"$(grep -rh -A1 --include='*.yml' --include='*.yaml' '# *dotfiles: *tags' $REPLY/ansible 2>/dev/null | sed -n 's/^ *\([A-Za-z0-9_-]*\):.*/\1/p')"})
  _wanted pins expl 'pinned variable' compadd -a names
}

_dotfiles() {
  local curcontext=$curcontext state state_descr line ret=1
  typeset -A opt_args
  local -a help=('(- : *)'{-h,--help}'[show help]')

  _arguments -C $help \
    '1: :->command' \
    '*:: :->argument' && ret=0

  case $state in
    command)
      local -a commands=(
        'check:fetch and show updates'
        'notify:notify from the last fetch'
        'update:choose and apply updates'
        'bump:bump pins to the latest'
        'refresh:fetch'
        'character:show or switch the Claude Code character'
      )
      _describe -t commands 'dotfiles command' commands && ret=0
      ;;
    argument)
      curcontext=${curcontext%:*:*}:dotfiles-$line[1]:
      case $line[1] in
        check | refresh)
          _arguments $help && ret=0
          ;;
        notify)
          _arguments $help \
            '--format=[output format]:format:(text claude)' \
            '--style=[style]:style:(plain powerline)' && ret=0
          ;;
        update)
          _arguments $help \
            '--only=[update without asking]:target:_sequence compadd - dotfiles tools brew all' \
            '--startup[for shell startup]' \
            '--style=[style]:style:(plain powerline)' && ret=0
          ;;
        bump)
          _arguments $help \
            '--steps=[steps to run]:step:_sequence compadd - write pr apply all' \
            '--merge[wait for CI and merge the PR]' \
            '--dry-run[show bumps without editing]' \
            '*:pinned variable:_dotfiles_pins' && ret=0
          ;;
        character)
          _arguments -C $help \
            '1: :->character_command' \
            '*:: :->character_argument' && ret=0
          case $state in
            character_command)
              local -a character_commands=('set:switch the character')
              _describe -t commands 'dotfiles character command' character_commands && ret=0
              ;;
            character_argument)
              [[ $line[1] == set ]] && _arguments $help '1:character:_dotfiles_characters' && ret=0
              ;;
          esac
          ;;
      esac
      ;;
  esac
  return ret
}

_dotfiles "$@"
